<Project>

  <PropertyGroup>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Generate packages.lock.json next to each .csproj so Release CI can restore with
         locked mode for reproducible transitive resolution. Local builds are unaffected;
         enforcement only happens when build.ps1 is invoked with -Locked. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
