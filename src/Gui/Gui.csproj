<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- The SDK can schedule the transitive Protocol reference twice for this mixed
         WPF/project graph; serialize project references to keep ordinary builds deterministic. -->
    <BuildInParallel>false</BuildInParallel>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Bunshin</AssemblyName>
    <RootNamespace>Gui</RootNamespace>
    <Version>0.1.0</Version>
    <Company>Bunshin</Company>
    <Product>Bunshin</Product>
    <Description>Bunshin Windows frontend for MaaFramework projects.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <BeautyLibsDir>./libs</BeautyLibsDir>
    <BeautyOnPublishOnly>True</BeautyOnPublishOnly>
    <BeautyUsePatch>True</BeautyUsePatch>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <EmbeddedResource Include="Assets\settings.json" />
    <None Update="DependencySetup_依赖库安装.bat" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="SubdirectoriesToProbe" Value="libs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" Version="3.0.4" />
    <PackageReference Include="nulastudio.NetBeauty" Version="2.1.5" />
    <PackageReference Include="Sentry" Version="6.12.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProjectModel\ProjectModel.csproj" />
    <ProjectReference Include="..\Updates\Updates.csproj" />
  </ItemGroup>

  <!-- One scrubber for everything either process uploads (ADR 0009). -->
  <ItemGroup>
    <Compile Include="..\Worker\TelemetryScrubber.cs" Link="Infrastructure\TelemetryScrubber.cs" />
  </ItemGroup>

</Project>
