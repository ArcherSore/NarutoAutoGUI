<UserControl x:Class="Gui.Views.ProjectAboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="0,0,0,6">
        <ContentControl x:Name="Description" Margin="0,4,0,0" Focusable="False" />
        <!-- Drawn as a sibling settings row: the negative margins cancel the about row's own padding. -->
        <Border x:Name="ContactRow" Margin="-16,20,-16,-20" Padding="16,14"
                BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Mail20" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Primary}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="联系方式" FontSize="{StaticResource FontSize.Body}" FontWeight="Medium"
                               Foreground="{StaticResource Brush.Text.Primary}" />
                    <ContentControl x:Name="Contact" Margin="0,2,0,0" Focusable="False" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
