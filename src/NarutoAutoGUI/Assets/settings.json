    {
      "id": "support",
      "title": "帮助与诊断",
      "items": [
        {
          "id": "export-diagnostics",
          "type": "action",
          "title": "问题诊断",
          "description": "打包运行日志、框架调试图片和版本信息，方便反馈问题。",
          "buttonText": "导出诊断包",
          "actionId": "diagnostics.export"
        },
        {
          "id": "replay-onboarding",
          "type": "action",
          "title": "新手指引",
          "description": "快速了解任务配置、运行控制和实时截图。",
          "buttonText": "查看指引",
          "actionId": "onboarding.replay"
        },
        {
          "id": "close-to-tray",
          "type": "toggle",
          "title": "关闭窗口时隐藏到托盘",
          "description": "开启后任务与桌面分身继续运行；关闭后退出程序。桌面分身仍在运行时会先确认退出。",
          "settingKey": "application.closeToTray"
        }
      ]
    },
    {
      "id": "framework",
      "title": "调试记录",
      "description": "更改后需结束桌面分身并重新准备运行环境才会生效。文件保存在程序目录的 debug 文件夹，导出诊断包时会一并打包。",
      "items": [
        {
          "id": "framework-save-on-error",
          "type": "toggle",
          "title": "保存失败截图",
          "description": "任务失败时保存当时的游戏画面（debug\\on_error），便于定位问题。",
          "settingKey": "framework.saveOnError"
        },
        {
          "id": "framework-save-draw",
          "type": "toggle",
          "title": "保存识别标注图",
          "description": "每次识别都保存一张标出识别结果的图片（debug\\vision）。占用磁盘较多，建议仅在排查问题时开启。",
          "settingKey": "framework.saveDraw"
        },
        {
          "id": "framework-debug-mode",
          "type": "toggle",
          "title": "框架调试模式",
          "description": "让框架保留更详细的识别信息，用于排查疑难问题。日常使用无需开启。",
          "settingKey": "framework.debugMode"
        }
      ]
    },
    {
