{
  "title": "设置",
  "sections": [
    {
      "id": "updates",
      "title": "更新",
      "items": [
        {
          "id": "current-version",
          "type": "info",
          "valueKey": "update.currentVersion",
          "title": "当前版本"
        },
        {
          "id": "startup-update-check",
          "type": "toggle",
          "title": "启动时检查更新",
          "settingKey": "update.checkOnStartup"
        },
        {
          "id": "check-update",
          "type": "action",
          "title": "检查 MaaNOP 更新",
          "buttonText": "检查更新",
          "actionId": "update.check"
        }
      ]
    },
    {
      "id": "child-session",
      "title": "桌面分身",
      "items": [
        {
          "id": "child-session-credentials",
          "type": "action",
          "title": "自动登录 Windows 账户",
          "description": "使用 PIN 或 Windows Hello 登录的电脑，桌面分身可能需要账户密码。保存后自动填写，但保存时不验证密码。",
          "buttonText": "保存或更新",
          "actionId": "childSession.credentials"
        }
      ]
    },
    {
      "id": "support",
      "title": "帮助与诊断",
      "items": [
        {
          "id": "export-diagnostics",
          "type": "action",
          "title": "问题诊断",
          "description": "打包日志、配置和调试图片，保存到程序目录的 debug\\exports 并定位到文件。每卷不超过 24.5 MB，可直接上传到 GitHub Issue。",
          "buttonText": "导出诊断包",
          "actionId": "diagnostics.export"
        },
        {
          "id": "replay-onboarding",
          "type": "action",
          "title": "新手指引",
          "description": "快速了解任务配置、运行控制和桌面分身观看。",
          "buttonText": "查看指引",
          "actionId": "onboarding.replay"
        },
        {
          "id": "close-to-tray",
          "type": "toggle",
          "title": "关闭窗口时隐藏到托盘",
          "description": "开启后任务与桌面分身继续运行；关闭后退出程序。桌面分身仍在运行时会先确认退出。",
          "settingKey": "application.closeToTray"
        }
      ]
    },
    {
      "id": "framework",
      "title": "调试记录",
      "description": "更改后从下一次识别开始生效，无需结束桌面分身。文件保存在程序目录的 debug 文件夹，超过 7 天的文件会在下次准备运行环境时清理。",
      "items": [
        {
          "id": "framework-save-on-error",
          "type": "toggle",
          "title": "保存失败截图",
          "description": "任务失败时保存当时的游戏画面（debug\\on_error），便于定位问题。",
          "settingKey": "framework.saveOnError"
        },
        {
          "id": "framework-save-draw",
          "type": "toggle",
          "title": "保存识别标注图",
          "description": "每次识别都保存一张标出识别结果的图片（debug\\vision）。占用磁盘较多，程序重启后会自动关闭。",
          "settingKey": "framework.saveDraw"
        },
        {
          "id": "framework-debug-mode",
          "type": "toggle",
          "title": "框架调试模式",
          "description": "让框架保留更详细的识别信息，用于排查疑难问题。日常使用无需开启。",
          "settingKey": "framework.debugMode"
        },
        {
          "id": "clear-debug-files",
          "type": "action",
          "title": "清理日志和调试文件",
          "description": "删除旧日志、失败截图、标注图和已导出的诊断包。正在写入的日志会保留，任务运行中不可用。",
          "buttonText": "清理",
          "actionId": "diagnostics.clear"
        },
        {
          "id": "clear-on-startup",
          "type": "toggle",
          "title": "启动时自动清理",
          "description": "每次打开程序时执行上面的清理。上次运行的日志和截图也会被删除，反馈问题前请勿开启。",
          "settingKey": "diagnostics.clearOnStartup"
        }
      ]
    },
    {
      "id": "sponsorship",
      "title": "支持项目",
      "items": [
        {
          "id": "open-afdian",
          "type": "action",
          "title": "支持 MaaNOP",
          "description": "如果 MaaNOP 对你有帮助，欢迎通过爱发电支持项目的持续开发与维护。感谢支持！",
          "buttonText": "前往爱发电 ↗",
          "actionId": "support.openAfdian"
        }
      ]
    }
  ]
}
