{
  "sections": [
    {
      "id": "general",
      "title": "通用",
      "icon": "Options20",
      "items": [
        {
          "id": "close-to-tray",
          "type": "toggle",
          "icon": "ArrowMinimize20",
          "title": "关闭窗口时隐藏到托盘",
          "description": "开启时任务和桌面分身继续运行；关闭时退出程序，桌面分身运行中会先确认。",
          "settingKey": "application.closeToTray"
        }
      ]
    },
    {
      "id": "child-session",
      "title": "桌面分身",
      "icon": "Desktop20",
      "items": [
        {
          "id": "child-session-credentials",
          "type": "action",
          "icon": "Key20",
          "title": "自动登录 Windows 账户",
          "description": "使用 PIN 或 Windows Hello 的电脑可能需要账户密码；保存时不验证。",
          "buttonText": "保存或更新",
          "actionId": "childSession.credentials"
        }
      ]
    },
    {
      "id": "updates",
      "title": "更新",
      "icon": "ArrowDownload20",
      "items": [
        {
          "id": "current-version",
          "type": "info",
          "icon": "Tag20",
          "valueKey": "update.currentVersion",
          "title": "当前版本"
        },
        {
          "id": "startup-update-check",
          "type": "toggle",
          "icon": "Power20",
          "title": "启动时检查更新",
          "settingKey": "update.checkOnStartup"
        },
        {
          "id": "check-update",
          "type": "action",
          "icon": "ArrowSync20",
          "title": "检查 MaaNOP 更新",
          "buttonText": "检查更新",
          "actionId": "update.check"
        }
      ]
    },
    {
      "id": "debug",
      "title": "调试",
      "icon": "Bug20",
      "description": "更改后从下一次识别开始生效，无需结束桌面分身。文件保存在程序目录的 debug 文件夹，超过 7 天的文件会在下次准备运行环境时清理。",
      "items": [
        {
          "id": "framework-save-on-error",
          "type": "toggle",
          "icon": "Image20",
          "title": "保存失败截图",
          "description": "任务失败时把游戏画面保存到 debug\\on_error。",
          "settingKey": "framework.saveOnError"
        },
        {
          "id": "framework-save-draw",
          "type": "toggle",
          "icon": "ScanText20",
          "joinPrevious": true,
          "title": "保存识别标注图",
          "description": "每次识别都保存一张标出识别结果的图片（debug\\vision）。占用磁盘较多，程序重启后会自动关闭。",
          "settingKey": "framework.saveDraw"
        },
        {
          "id": "framework-debug-mode",
          "type": "toggle",
          "icon": "WindowDevTools20",
          "joinPrevious": true,
          "title": "框架调试模式",
          "description": "保留更详细的识别信息，日常使用无需开启。",
          "settingKey": "framework.debugMode"
        },
        {
          "id": "export-diagnostics",
          "type": "action",
          "icon": "Archive20",
          "title": "问题诊断",
          "description": "打包日志、配置和调试图片，保存到程序目录的 debug\\exports 并定位到文件。可直接上传到 GitHub Issue。",
          "buttonText": "导出诊断包",
          "actionId": "diagnostics.export"
        },
        {
          "id": "clear-debug-files",
          "type": "action",
          "icon": "Broom20",
          "title": "清理日志和调试文件",
          "description": "删除旧日志、失败截图、标注图和已导出的诊断包。正在写入的日志会保留。",
          "buttonText": "清理",
          "actionId": "diagnostics.clear"
        },
        {
          "id": "clear-on-startup",
          "type": "toggle",
          "icon": "Power20",
          "joinPrevious": true,
          "title": "启动时自动清理",
          "description": "每次打开程序时执行上面的清理。上次运行的日志和截图也会被删除，反馈问题前请勿开启。",
          "settingKey": "diagnostics.clearOnStartup"
        }
      ]
    },
    {
      "id": "about",
      "title": "关于",
      "icon": "Info20",
      "items": [
        {
          "id": "about-app",
          "type": "about",
          "title": "MaaNOP"
        },
        {
          "id": "view-welcome",
          "type": "action",
          "joinPrevious": true,
          "icon": "Sparkle20",
          "title": "欢迎信息",
          "description": "查看 MaaNOP 的欢迎信息和公告。",
          "buttonText": "查看欢迎信息",
          "actionId": "welcome.view"
        },
        {
          "id": "project-repository",
          "type": "action",
          "joinPrevious": true,
          "icon": "Code20",
          "title": "项目仓库",
          "description": "在 GitHub 查看 MaaNOP 的源代码。",
          "buttonText": "前往 GitHub ↗",
          "actionId": "project.openRepository"
        },
        {
          "id": "project-license",
          "type": "action",
          "joinPrevious": true,
          "icon": "Document20",
          "title": "许可证",
          "description": "MaaNOP 的开源许可证。",
          "buttonText": "查看许可证",
          "actionId": "project.viewLicense"
        },
        {
          "id": "replay-onboarding",
          "type": "action",
          "icon": "Lightbulb20",
          "title": "新手指引",
          "description": "了解任务配置、运行控制和桌面分身观看。",
          "buttonText": "查看指引",
          "actionId": "onboarding.replay"
        },
        {
          "id": "open-afdian",
          "type": "action",
          "icon": "Heart20",
          "title": "支持 MaaNOP",
          "description": "欢迎通过爱发电支持 MaaNOP 的持续开发与维护。",
          "buttonText": "前往爱发电 ↗",
          "actionId": "support.openAfdian"
        }
      ]
    }
  ]
}
