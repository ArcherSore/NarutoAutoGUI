<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- The SDK can schedule the transitive Protocol reference twice for this mixed
         WPF/project graph; serialize project references to keep ordinary builds deterministic. -->
    <BuildInParallel>false</BuildInParallel>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NarutoAutoGUI</AssemblyName>
    <RootNamespace>NarutoAutoGUI</RootNamespace>
    <Version>0.1.0</Version>
    <Company>NarutoAutoGUI</Company>
    <Product>NarutoAutoGUI</Product>
    <Description>NarutoAutoGUI Windows frontend for MaaNOP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NarutoAutoGUI.ProjectModel\NarutoAutoGUI.ProjectModel.csproj" />
  </ItemGroup>

</Project>
