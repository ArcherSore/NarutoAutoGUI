<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Primitive colors -->
    <Color x:Key="Color.Neutral.0">#FFFFFF</Color>
    <Color x:Key="Color.Neutral.25">#FCFDFE</Color>
    <Color x:Key="Color.Neutral.50">#F6F8FB</Color>
    <Color x:Key="Color.Neutral.100">#EEF2F6</Color>
    <Color x:Key="Color.Neutral.200">#D6DEE8</Color>
    <Color x:Key="Color.Neutral.300">#B7C2CF</Color>
    <Color x:Key="Color.Neutral.500">#5F6E80</Color>
    <Color x:Key="Color.Neutral.600">#465467</Color>
    <Color x:Key="Color.Neutral.800">#26313F</Color>
    <Color x:Key="Color.Neutral.900">#182230</Color>
    <Color x:Key="Color.Indigo.50">#EDF3FF</Color>
    <Color x:Key="Color.Indigo.100">#DCE8FC</Color>
    <Color x:Key="Color.Indigo.200">#B8CCF4</Color>
    <Color x:Key="Color.Indigo.600">#3156A3</Color>
    <Color x:Key="Color.Indigo.700">#284A91</Color>
    <Color x:Key="Color.Indigo.800">#203F7E</Color>
    <Color x:Key="Color.Orange.50">#FFF1EA</Color>
    <Color x:Key="Color.Orange.600">#B84D26</Color>

    <!-- Semantic colors -->
    <Color x:Key="Color.Info.Surface">#EBF1FC</Color>
    <Color x:Key="Color.Info.Foreground">#244C92</Color>
    <Color x:Key="Color.Success.Strong">#26734D</Color>
    <Color x:Key="Color.Success.Surface">#E7F5EC</Color>
    <Color x:Key="Color.Success.Border">#A9D7BF</Color>
    <Color x:Key="Color.Success.Foreground">#17633E</Color>
    <Color x:Key="Color.Warning.Strong">#8A5400</Color>
    <Color x:Key="Color.Warning.Surface">#FFF3D6</Color>
    <Color x:Key="Color.Warning.Border">#E8C572</Color>
    <Color x:Key="Color.Warning.Foreground">#7A4700</Color>
    <Color x:Key="Color.Error.Strong">#B4232F</Color>
    <Color x:Key="Color.Error.Surface">#FDEBED</Color>
    <Color x:Key="Color.Error.Border">#E7AAB0</Color>
    <Color x:Key="Color.Error.Foreground">#9E1C2A</Color>

    <!-- Stable brushes are frozen to avoid Freezable change tracking. -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Neutral.50}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Neutral.0}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.Subdued" Color="{StaticResource Color.Neutral.50}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.Disabled" Color="{StaticResource Color.Neutral.100}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Neutral.200}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#7B899B" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Neutral.900}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Body" Color="{StaticResource Color.Neutral.800}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Neutral.600}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Neutral.500}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#718096" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Inverse" Color="{StaticResource Color.Neutral.0}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Indigo.600}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Primary.Hover" Color="{StaticResource Color.Indigo.700}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Primary.Pressed" Color="{StaticResource Color.Indigo.800}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Primary.Surface" Color="{StaticResource Color.Indigo.50}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Primary.SurfaceHover" Color="{StaticResource Color.Indigo.100}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Primary.Border" Color="{StaticResource Color.Indigo.200}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BrandAccent" Color="{StaticResource Color.Orange.600}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Info.Surface" Color="{StaticResource Color.Info.Surface}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Info.Foreground" Color="{StaticResource Color.Info.Foreground}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success.Strong}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Success.Surface" Color="{StaticResource Color.Success.Surface}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Success.Border" Color="{StaticResource Color.Success.Border}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Success.Foreground"
                     Color="{StaticResource Color.Success.Foreground}"
                     po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TasksAccent" Color="{StaticResource Color.Success.Strong}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TasksAccent.Surface"
                     Color="{StaticResource Color.Success.Surface}"
                     po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TasksAccent.Border"
                     Color="{StaticResource Color.Success.Border}"
                     po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning.Strong}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning.Surface" Color="{StaticResource Color.Warning.Surface}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning.Border" Color="{StaticResource Color.Warning.Border}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning.Foreground"
                     Color="{StaticResource Color.Warning.Foreground}"
                     po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error.Strong}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error.Surface" Color="{StaticResource Color.Error.Surface}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error.Border" Color="{StaticResource Color.Error.Border}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error.Foreground" Color="{StaticResource Color.Error.Foreground}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" po:Freeze="True" />

    <!-- Typography and dimensions -->
    <FontFamily x:Key="FontFamily.Ui">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FontFamily.Monospace">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    <sys:Double x:Key="FontSize.WindowTitle">20</sys:Double>
    <sys:Double x:Key="FontSize.Status">16</sys:Double>
    <sys:Double x:Key="FontSize.SectionTitle">14</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Label">12</sys:Double>
    <sys:Double x:Key="FontSize.Meta">12</sys:Double>
    <Thickness x:Key="Thickness.Window">24</Thickness>
    <Thickness x:Key="Thickness.Section">16</Thickness>
    <Thickness x:Key="Thickness.Control">12,6</Thickness>
    <Thickness x:Key="Thickness.ControlPrimary">16,6</Thickness>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Section">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">8</CornerRadius>

    <Style x:Key="ControlFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3"
                            BorderBrush="{StaticResource Brush.Primary}"
                            BorderThickness="2"
                            CornerRadius="8"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TasksFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3"
                            BorderBrush="{StaticResource Brush.TasksAccent}"
                            BorderThickness="2"
                            CornerRadius="8"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DropShadowEffect x:Key="Effect.Surface.Light"
                      BlurRadius="8"
                      Direction="270"
                      Opacity="0.08"
                      ShadowDepth="1" />
    <DropShadowEffect x:Key="Effect.Surface.Drag"
                      BlurRadius="12"
                      Direction="270"
                      Opacity="0.14"
                      ShadowDepth="2" />

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource Brush.Canvas}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Body}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Body}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    </Style>

    <Style x:Key="WindowTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.WindowTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="LineHeight" Value="28" />
    </Style>

    <Style x:Key="StatusPrimaryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Status}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.SectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
    </Style>

    <Style x:Key="MonospaceMetaTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MutedTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Monospace}" />
    </Style>

    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Control}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource Brush.Surface.Disabled}" />
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource Brush.Border}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Inverse}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.ControlPrimary}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.Primary.Hover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary.Hover}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.Primary.Pressed}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary.Pressed}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.Primary.Surface}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.Primary.SurfaceHover}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtleButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Transparent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Body}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.Surface.Disabled}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.Border}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DestructiveButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Error}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.Error.Surface}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.Error.Border}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NewLogsButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{StaticResource Brush.Primary.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
    </Style>

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}" />

    <!-- Inputs -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Body}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Primary.Border}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource Brush.Text.Secondary}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="TextBoxBorder"
                                    Property="Background"
                                    Value="{StaticResource Brush.Surface.Subdued}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TextBoxBorder"
                                    Property="Background"
                                    Value="{StaticResource Brush.Surface.Disabled}" />
                            <Setter TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource Brush.Border}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatusPanelStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush.Primary.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Section}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Section}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Settings and property editors -->
    <Style x:Key="SettingsSectionPanelStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Section}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Section}" />
    </Style>

    <Style x:Key="TaskShelfHeaderButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TasksFocusVisualStyle}" />
    </Style>

    <Style x:Key="TaskShelfSurfaceStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Subdued}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    </Style>

    <Style x:Key="TaskChipButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Body}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TasksFocusVisualStyle}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.TasksAccent.Surface}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.TasksAccent.Border}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.TasksAccent}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CompactIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TasksFocusVisualStyle}" />
    </Style>

    <Style x:Key="PlanHeaderButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TasksFocusVisualStyle}" />
    </Style>

    <Style x:Key="PlanItemStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="PlanItemExpandedStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource PlanItemStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.TasksAccent.Border}" />
        <Setter Property="Effect" Value="{StaticResource Effect.Surface.Light}" />
    </Style>

    <Style x:Key="OptionTileStyle" TargetType="{x:Type Border}">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Subdued}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    </Style>

    <Style x:Key="TaskDescriptionDrawerStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="CornerRadius" Value="8,0,0,8" />
        <Setter Property="Effect" Value="{StaticResource Effect.Surface.Drag}" />
    </Style>

    <!-- Logs -->
    <Style x:Key="LogListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="{StaticResource Brush.Transparent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush.Transparent}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource Brush.Primary.Surface}" />
                            <Setter TargetName="ItemBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource Brush.Primary.Border}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LogListBoxStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Subdued}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Monospace}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource LogListBoxItemStyle}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}"
                            Focusable="False"
                            CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Border}" />
    </Style>
</ResourceDictionary>
