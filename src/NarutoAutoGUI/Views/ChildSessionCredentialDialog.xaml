<ui:FluentWindow x:Class="NarutoAutoGUI.Views.ChildSessionCredentialDialog"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="自动登录 Windows 账户"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="460"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 Background="{StaticResource Brush.Surface}"
                 Foreground="{StaticResource Brush.Text.Body}"
                 FontFamily="{StaticResource FontFamily.Ui}"
                 FontSize="{StaticResource FontSize.Body}"
                 ExtendsContentIntoTitleBar="True"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True"
                 TextOptions.TextFormattingMode="Display">
    <ui:FluentWindow.Resources>
        <!-- The implicit TextBlock style would otherwise recolour button captions. -->
        <DataTemplate x:Key="ButtonLabel">
            <TextBlock Text="{Binding}" FontWeight="SemiBold"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </DataTemplate>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="自动登录 Windows 账户" ShowMaximize="False" ShowMinimize="False"
                     Background="{StaticResource Brush.Surface}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Grid.Row="1" Margin="24,4,24,0">
            <TextBlock TextWrapping="Wrap" LineHeight="22"
                       Text="保存后，创建或恢复桌面分身时将自动登录，无需每次输入密码。" />

            <TextBlock Text="账户" Margin="0,20,0,6" Style="{StaticResource FieldLabel}" />
            <ui:TextBox x:Name="UserNameBox" PlaceholderText="例如 MicrosoftAccount\name@outlook.com"
                        ClearButtonEnabled="False" AutomationProperties.Name="Windows 账户" />
            <TextBlock Style="{StaticResource FieldHint}"
                       Text="Microsoft 账户填写 MicrosoftAccount\邮箱，本地账户填写用户名。" />

            <TextBlock Text="密码" Margin="0,16,0,6" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Windows 账户密码" />
            <TextBlock Style="{StaticResource FieldHint}"
                       Text="填写 Windows 账户密码，不是 PIN 或 Windows Hello。" />

            <Border Margin="0,20,0,0" Padding="12,10" Background="{StaticResource Brush.Surface.Option}"
                    CornerRadius="{StaticResource Radius.Control}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top"
                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                   Text="由 Windows 凭据管理器加密保存，仅当前 Windows 用户可读取，不写入配置、日志或诊断包。" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}"
                                   Text="保存成功不代表密码正确，请创建桌面分身确认能否自动登录。" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{StaticResource Brush.Error.Foreground}"
                       AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="24,24,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteButton" Content="删除已保存" HorizontalAlignment="Left"
                    Style="{StaticResource DestructiveButtonStyle}" ContentTemplate="{StaticResource ButtonLabel}"
                    Click="Delete_Click" />
            <Button Grid.Column="1" Content="取消" MinWidth="88" Margin="0,0,8,0" IsCancel="True"
                    Style="{StaticResource NeutralSecondaryButtonStyle}"
                    ContentTemplate="{StaticResource ButtonLabel}" />
            <Button x:Name="SaveButton" Grid.Column="2" Content="保存" MinWidth="88" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" ContentTemplate="{StaticResource ButtonLabel}"
                    Click="Save_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
