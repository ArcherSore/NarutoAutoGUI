                                      FocusVisualStyle="{x:Null}"
                                      ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" ShowsPreview="False"
                                      Cursor="SizeWE" KeyboardIncrement="10"
                                      AutomationProperties.Name="调整运行控制栏宽度"
                                      AutomationProperties.HelpText="拖动或使用左右方向键调整宽度" />
                        <!-- One runtime console: run control and grouped activity as sections. The desktop viewer
                             is its own window, toggled from the run control header. -->
                        <Border x:Name="RuntimeSidebar" Grid.Column="1" Margin="0,14,16,16"
                                Style="{StaticResource Console.Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="RuntimeControlCard" Margin="16,10,12,14">
                                    <StackPanel.Resources>
                                        <Style x:Key="Panel.Button" TargetType="Button">
                                            <Setter Property="Height" Value="36" />
                                            <Setter Property="Padding" Value="12,0" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Background" Value="#FFFFFF" />
                                            <Setter Property="Foreground" Value="#182230" />
                                            <Setter Property="BorderBrush" Value="#D6DEE8" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style x:Key="Panel.Window" TargetType="Button"
                                            BasedOn="{StaticResource Panel.Button}">
                                            <Setter Property="Background" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#D6DEE8" />
                                            <Setter Property="Foreground" Value="#182230" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F6F8FB" />
                                                    <Setter Property="BorderBrush" Value="#7B899B" />
                                                    <Setter Property="Foreground" Value="#182230" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#EEF2F6" />
                                                    <Setter Property="BorderBrush" Value="#7B899B" />
                                                    <Setter Property="Foreground" Value="#182230" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#E4EAF0" />
                                                    <Setter Property="Foreground" Value="#718096" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="Panel.Primary" TargetType="Button"
                                            BasedOn="{StaticResource Panel.Button}">
                                            <Setter Property="Background" Value="#3156A3" />
                                            <Setter Property="BorderBrush" Value="#3156A3" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#284A91" />
                                                    <Setter Property="BorderBrush" Value="#284A91" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#203F7E" />
                                                    <Setter Property="BorderBrush" Value="#203F7E" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#EDF3FF" />
                                                    <Setter Property="BorderBrush" Value="#B8CCF4" />
                                                    <Setter Property="Foreground" Value="#3156A3" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="Panel.Stop" TargetType="Button"
                                            BasedOn="{StaticResource Panel.Button}">
                                            <Setter Property="Background" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#E7AAB0" />
                                            <Setter Property="Foreground" Value="#9E1C2A" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FDEBED" />
                                                    <Setter Property="BorderBrush" Value="#B4232F" />
                                                    <Setter Property="Foreground" Value="#9E1C2A" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#FDEBED" />
                                                    <Setter Property="BorderBrush" Value="#B4232F" />
                                                    <Setter Property="Foreground" Value="#9E1C2A" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#E7AAB0" />
                                                    <Setter Property="Foreground" Value="#9E1C2A" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Grid Height="32" Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="桌面分身" FontSize="13" FontWeight="SemiBold"
                                            Foreground="#182230" VerticalAlignment="Center" />
                                        <Border x:Name="RuntimeStatusPill" Grid.Column="1" Margin="10,0,0,0"
                                            Background="Transparent" Padding="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="SessionStatusDot" Width="7" Height="7"
                                                    VerticalAlignment="Center"
                                                    Fill="#26734D" />
                                                <TextBlock x:Name="RuntimeStatusText" Margin="6,0,0,0" FontSize="12"
                                                    FontWeight="Normal" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="RuntimeMoreButton" Grid.Column="4"
                                            Width="32" Height="32" Style="{StaticResource Preview.IconButton}"
                                            ToolTip="分身管理" AutomationProperties.Name="分身管理"
                                            Click="RuntimeMoreButton_Click">
                                            <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="18" />
                                            <Button.ContextMenu>
                                                <ContextMenu x:Name="RuntimeMoreMenu" Width="256" Padding="4"
                                                    Background="#FFFFFF" BorderBrush="#D6DEE8" BorderThickness="1"
                                                    FontFamily="{StaticResource FontFamily.Ui}" FontSize="13"
                                                    FontWeight="Normal" Foreground="#26313F">
                                                    <ContextMenu.Template>
                                                        <ControlTemplate TargetType="ContextMenu">
                                                            <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="1" CornerRadius="6" Padding="4">
                                                                <ItemsPresenter
                                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ContextMenu.Template>
                                        <ContextMenu.Resources>
                                            <Style TargetType="Separator">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Separator">
                                                            <Border Height="1" Margin="6,4"
                                                                Background="#E4EAF0" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="FontSize" Value="13" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="Foreground" Value="#26313F" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="MenuItem">
                                                            <Border x:Name="Row" CornerRadius="6"
                                                                Padding="10,6" Background="Transparent"
                                                                MinHeight="32">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="16" />
                                                                        <ColumnDefinition Width="10" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ContentPresenter x:Name="IconHost"
                                                                        ContentSource="Icon"
                                                                        VerticalAlignment="Center" />
                                                                    <Border x:Name="CheckBox"
                                                                        Visibility="Collapsed"
                                                                        Width="16" Height="16"
                                                                        BorderBrush="#7B899B"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4">
                                                                        <Path x:Name="Check"
                                                                            Visibility="Collapsed"
                                                                            Data="M3 7L6 10L12 4"
                                                                            Stroke="White"
                                                                            StrokeThickness="1.5" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock
                                                                            Text="{TemplateBinding Header}"
                                                                            FontSize="13"
                                                                            FontWeight="Normal"
                                                                            Foreground="{TemplateBinding Foreground}" />
                                                                        <TextBlock x:Name="Note" Margin="0,1,0,0"
                                                                            Text="{TemplateBinding Tag}"
                                                                            FontSize="11.5"
                                                                            FontWeight="Normal"
                                                                            Foreground="#5F6E80" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsHighlighted"
                                                                Value="True">
                                                                    <Setter TargetName="Row"
                                                                        Property="Background"
                                                                        Value="#EEF2F6" />
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsHighlighted"
                                                                            Value="True" />
                                                                        <Condition Property="Name"
                                                                            Value="EndEnvironmentMenuItem" />
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Row"
                                                                        Property="Background"
                                                                        Value="#FDEBED" />
                                                                </MultiTrigger>
                                                                <Trigger Property="IsCheckable"
                                                                Value="True">
                                                                    <Setter TargetName="IconHost"
                                                                        Property="Visibility"
                                                                        Value="Collapsed" />
                                                                    <Setter TargetName="CheckBox"
                                                                        Property="Visibility"
                                                                        Value="Visible" />
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="CheckBox"
                                                                        Property="Background"
                                                                        Value="#3156A3" />
                                                                    <Setter TargetName="CheckBox"
                                                                        Property="BorderBrush"
                                                                        Value="#3156A3" />
                                                                    <Setter TargetName="Check"
                                                                        Property="Visibility"
                                                                        Value="Visible" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Foreground"
                                                                    Value="#718096" />
                                                                    <Setter TargetName="Row"
                                                                        Property="Background"
                                                                        Value="Transparent" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                                    </ContextMenu.Resources>
                                                    <MenuItem x:Name="StartSessionMenuItem" Header="仅启动分身"
                                                        Tag="不运行任务" Click="PrepareEnvironmentButton_Click">
                                                        <MenuItem.Icon>
                                                            <Viewbox Width="16" Height="16">
                                                                <Canvas Width="20" Height="20">
                                                                    <Path StrokeThickness="1.5"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeEndLineCap="Round"
                                                                        StrokeLineJoin="Round"
                                                                        Stroke="#26313F"
                                                                        Data="M10 3.5v6M6.4 5.9a5.7 5.7 0 1 0 7.2 0" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Visibility="Collapsed" x:Name="OpenLogsMenuItem"
                                                        Header="打开日志目录" Click="OpenLogsMenuItem_Click" />
                                                    <MenuItem x:Name="EndEnvironmentMenuItem" Header="结束桌面分身"
                                                        Tag="注销分身，游戏随之关闭" Foreground="#9E1C2A"
                                                        Click="EndEnvironmentMenuItem_Click">
                                                        <MenuItem.Icon>
                                                            <Viewbox Width="16" Height="16">
                                                                <Canvas Width="20" Height="20">
                                                                    <Path StrokeThickness="1.5"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeEndLineCap="Round"
                                                                        StrokeLineJoin="Round"
                                                                        Stroke="#9E1C2A"
                                                                        Data="M8 4.5H5.5a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1H8
                                                                            M11.5 6.5 15 10l-3.5 3.5M15 10H8" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator x:Name="SessionMenuSeparator" />
                                                    <MenuItem x:Name="AutoSessionMenuItem" IsCheckable="True"
                                                        StaysOpenOnClick="True" Click="AutoSessionMenuItem_Click"
                                                        Header="打开程序时自动启动分身" Tag="不会自动开始任务" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                    <!-- Exactly one primary action shows; RuntimeControls decides which. -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="DesktopViewButton" Grid.Column="0" Margin="0,0,4,0"
                                            IsEnabled="False"
                                            Style="{StaticResource Panel.Window}"
                                            AutomationProperties.Name="桌面分身：未启动"
                                            Click="DesktopViewButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="16" Height="16">
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="20" Height="20">
                                                            <Path x:Name="DesktopViewIcon" StrokeThickness="1.5"
                                                                StrokeStartLineCap="Round"
                                                                        StrokeEndLineCap="Round"
                                                                StrokeLineJoin="Round"
                                                                Stroke="{Binding Foreground, RelativeSource={
                                                                    RelativeSource AncestorType=Button}}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                                <TextBlock x:Name="DesktopViewText" Text="显示窗口" Margin="8,0,0,0"
                                                    FontSize="13"
                                                    Style="{StaticResource Console.ButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <Grid Grid.Column="1" Margin="4,0,0,0">
                                            <Button x:Name="PrepareEnvironmentButton"
                                                Style="{StaticResource Panel.Primary}"
                                                AutomationProperties.Name="启动并运行"
                                                Click="PrepareAndRunButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                                        <Canvas Width="20" Height="20">
                                                            <Path StrokeThickness="1.5" StrokeLineJoin="Round"
                                                                Stroke="{Binding Foreground, RelativeSource={
                                                                    RelativeSource AncestorType=Button}}"
                                                                Data="M6.6 4.9v10.2a.6.6 0 0 0 .9.5l8.1-5.1
                                                                    a.6.6 0 0 0 0-1L7.5 4.4a.6.6 0 0 0-.9.5Z" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="启动并运行"
                                                        Style="{StaticResource Console.ButtonText}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="RetryEnvironmentButton" Visibility="Collapsed"
                                                Style="{StaticResource Panel.Primary}"
                                                ToolTipService.ShowOnDisabled="True"
                                                Click="RetryRuntimeHeaderButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="ArrowClockwise20" FontSize="16"
                                                        Margin="0,0,8,0" />
                                                    <TextBlock x:Name="RetryEnvironmentText" Text="重试"
                                                        Style="{StaticResource Console.ButtonText}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="StartTaskHeaderButton" Visibility="Collapsed"
                                                Style="{StaticResource Panel.Primary}"
                                                ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="开始任务"
                                                Click="StartRunButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                                        <Canvas Width="20" Height="20">
                                                            <Path StrokeThickness="1.5" StrokeLineJoin="Round"
                                                                Stroke="{Binding Foreground, RelativeSource={
                                                                    RelativeSource AncestorType=Button}}"
                                                                Data="M6.6 4.9v10.2a.6.6 0 0 0 .9.5l8.1-5.1
                                                                    a.6.6 0 0 0 0-1L7.5 4.4a.6.6 0 0 0-.9.5Z" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="开始任务"
                                                        Style="{StaticResource Console.ButtonText}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="StopTaskHeaderButton" Visibility="Collapsed"
                                                Style="{StaticResource Panel.Stop}"
                                                AutomationProperties.Name="停止任务"
                                                Click="StopRunButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                                        <Canvas Width="20" Height="20">
                                                            <Path StrokeThickness="1.5" StrokeLineJoin="Round"
                                                                Stroke="{Binding Foreground, RelativeSource={
                                                                    RelativeSource AncestorType=Button}}"
                                                                Data="M7.2 6H12.8Q14 6 14 7.2V12.8Q14 14 12.8 14
                                                                    H7.2Q6 14 6 12.8V7.2Q6 6 7.2 6Z" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="停止任务"
                                                        Style="{StaticResource Console.ButtonText}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="RecoverEnvironmentButton" Visibility="Collapsed"
                                                Style="{StaticResource Panel.Stop}"
                                                ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="结束桌面分身"
                                                Click="RecoverEnvironmentButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="SignOut20" FontSize="16" Margin="0,0,8,0" />
                                                    <TextBlock Text="结束桌面分身"
                                                        Style="{StaticResource Console.ButtonText}" />
                                                </StackPanel>
                                            </Button>
                                            <Border x:Name="RuntimeHeaderProgressRing" Height="36" CornerRadius="6"
                                                Visibility="Collapsed"
                                                Background="#EDF3FF" BorderBrush="#B8CCF4" BorderThickness="1"
                                                AutomationProperties.Name="正在启动并运行">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                                        VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock x:Name="RuntimeProgressText" FontWeight="SemiBold"
                                                        VerticalAlignment="Center"
                                                        Foreground="#3156A3" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    <Border x:Name="RunSummaryCard" Margin="0,12,0,0" Padding="12,10"
                                        CornerRadius="8" BorderThickness="1"
                                        Background="{StaticResource Brush.Surface.Subdued}"
                                        BorderBrush="#E4EAF0">
                                        <StackPanel>
                                            <TextBlock x:Name="RuntimeStatusTitle" Margin="0,0,0,0" FontSize="14"
                                                FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                Foreground="{StaticResource Brush.Text.Primary}" />
                                            <TextBlock x:Name="RuntimeStatusDetail" Margin="0,2,0,0" FontSize="12.5"
                                                TextWrapping="Wrap" LineHeight="19"
                                                Foreground="{StaticResource Brush.Text.Secondary}" />
                                            <StackPanel x:Name="RunProgressPanel" Margin="0,8,0,0"
                                                Visibility="Collapsed">
                                                <Canvas x:Name="RunProgressBar" Height="6" ClipToBounds="True"
                                                    SizeChanged="RunProgressBar_SizeChanged" />
                                                <Grid Margin="0,7,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="RunProgressCaption" FontSize="12"
                                                        TextTrimming="CharacterEllipsis"
                                                        Foreground="{StaticResource Brush.Text.Muted}" />
                                                    <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                        x:Name="RunProgressElapsed" FontSize="12"
                                                        HorizontalAlignment="Right"
                                                        Foreground="{StaticResource Brush.Text.Muted}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.RowSpan="2" Style="{StaticResource Console.Section}" />
                                    <Grid Style="{StaticResource Console.SectionHeader}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="运行动态" Style="{StaticResource Console.SectionTitle}" />
                                            <TextBlock x:Name="RunLogCountText" Margin="8,0,0,0" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.Text.Muted}" />
                                        </StackPanel>
                                        <Button x:Name="ClearActivityButton" Grid.Column="1" ToolTip="清空面板中的运行动态"
                                                Style="{StaticResource Activity.ClearButton}"
                                                Click="ClearActivity_Click"
                                                IsEnabled="{Binding HasItems, ElementName=HomeLogListBox}"
                                                AutomationProperties.Name="清空运行动态">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="14" Stretch="Uniform" Margin="0,0,5,0"
                                                      Stroke="{Binding Foreground,
                                                          RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                                      Data="M3,6 L21,6 M9,6 L9,3 L15,3 L15,6
                                                            M5,6 L6,22 L18,22 L19,6 M10,10 L10,18 M14,10 L14,18" />
                                                <TextBlock Text="清空" FontSize="11"
                                                           Foreground="{Binding Foreground,
                                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="8,0,8,8">
                                        <ListBox x:Name="HomeLogListBox" ItemsSource="{Binding LogLines}"
                                                 Style="{StaticResource LogListBoxStyle}"
                                                 Background="{StaticResource Brush.Surface}"
                                                 BorderThickness="0" Padding="0"
                                                 FontFamily="{StaticResource FontFamily.Ui}"
                                                 VirtualizingPanel.ScrollUnit="Item"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="运行动态"
                                                 AutomationProperties.HelpText="最新在顶部，按任务分组，仅显示 MaaNOP 用户运行日志">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}"
                                                       BasedOn="{StaticResource LogListBoxItemStyle}">
                                                    <!-- A group heading always sits on top, so the newest
                                                         entry is the second row. -->
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding
                                                                    Converter="{StaticResource Activity.IsLatest}">
                                                                    <Binding />
                                                                    <Binding Path="ItemsSource[1]"
                                                                             RelativeSource="{RelativeSource
                                                                        AncestorType=ListBox}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource Brush.Primary.Surface}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.Resources>
                                                <DataTemplate DataType="{x:Type models:RunLogGroup}">
                                                    <Grid Margin="6,8,6,2" Focusable="False">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                                   FontWeight="SemiBold" MaxWidth="240"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource Brush.Text.Muted}" />
                                                        <Border Grid.Column="1" Height="1" Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Background="{StaticResource Brush.Border.Subtle}" />
                                                    </Grid>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type models:LogEntry}">
                                                    <Border MinHeight="28" Padding="6,5"
                                                            BorderBrush="#EDF2F8" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="12" Foreground="#667FA5" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                                       Foreground="{StaticResource Brush.Text.Primary}"
                                                                       FontSize="12" TextWrapping="Wrap"
                                                                       AutomationProperties.HelpText="{Binding
                                                                           DisplayLevel}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.Resources>
                                        </ListBox>
                                        <Grid IsHitTestVisible="False">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems,
                                                            ElementName=HomeLogListBox}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                                                <StackPanel Width="300" HorizontalAlignment="Center">
                                                    <Grid Width="72" Height="64" Margin="0,0,0,8">
                                                        <Ellipse Width="64" Height="64" Fill="#F1F6FD" />
                                                        <Border Width="34" Height="34" CornerRadius="4"
                                                                Background="#C4D6EE" VerticalAlignment="Center">
                                                            <Path Margin="7" Stroke="White" StrokeThickness="3"
                                                                  StrokeStartLineCap="Round"
                                                                        StrokeEndLineCap="Round"
                                                                  Data="M0,3 L20,3 M0,10 L20,10 M0,17 L12,17" />
                                                        </Border>
                                                        <Ellipse Width="4" Height="4" Fill="#CBDDF5"
                                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                 Margin="0,15,0,0" />
                                                        <Path Fill="#CBDDF5" HorizontalAlignment="Right"
                                                              VerticalAlignment="Top" Data="M4,0 L5,3 L8,4 L5,5
                                                                                              L4,8 L3,5 L0,4 L3,3 Z" />
                                                    </Grid>
                                                    <TextBlock Text="暂无运行动态" TextAlignment="Center"
                                                               Style="{StaticResource SectionTitleTextStyle}" />
                                                    <TextBlock Text="任务开始后，将在此处显示关键状态更新"
                                                               TextAlignment="Center" Margin="0,6,0,0" FontSize="11"
                                                               Foreground="#667FA5" />
                                                </StackPanel>
                                            </Viewbox>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <views:SettingsView x:Name="SettingsView" Visibility="Collapsed" />
                    <views:HelpView x:Name="HelpView" Visibility="Collapsed" />

                    <Grid x:Name="TaskDescriptionOverlay"
                          Panel.ZIndex="100"
                          Visibility="Collapsed"
                          AutomationProperties.Name="任务描述">
                        <Button Background="{StaticResource Brush.Overlay.Dim}"
                                BorderThickness="0"
                                Focusable="False"
                                Click="TaskDescriptionScrim_Click" />
                        <Border Width="420"
                                MaxWidth="420"
                                HorizontalAlignment="Right"
                                Style="{StaticResource TaskDescriptionDrawerStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TaskDescriptionDrawerTitle"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource StatusPrimaryTextStyle}" />
                                    <Button x:Name="TaskDescriptionCloseButton"
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Style="{StaticResource CompactIconButtonStyle}"
                                            AutomationProperties.Name="关闭任务描述"
                                            Click="TaskDescriptionCloseButton_Click">
                                        <ui:SymbolIcon Width="16" Height="16" Symbol="Dismiss16" />
                                    </Button>
                                </Grid>
                                <Border Grid.Row="1"
                                        Height="1"
                                        Margin="0,14,0,14"
                                        Background="{StaticResource Brush.Border}" />
                                <FlowDocumentScrollViewer x:Name="TaskDescriptionViewer" Grid.Row="2"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto"
                                                          IsToolBarVisible="False" Zoom="100" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
        <Grid x:Name="UpdateOverlay" Panel.ZIndex="210" Visibility="Collapsed" Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              SizeChanged="UpdateOverlay_SizeChanged"
              AutomationProperties.Name="软件更新">
            <Button Background="#59111927" BorderThickness="0" Focusable="False" IsTabStop="False"
                    Click="CloseUpdate_Click" AutomationProperties.Name="关闭软件更新遮罩">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border x:Name="UpdateDialog" Width="440" MaxHeight="600" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Preview.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Section}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.2" Color="#0F172A" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,-8,-8,16">
                        <Button x:Name="CloseUpdateButton" DockPanel.Dock="Right"
                                Style="{StaticResource Preview.IconButton}" Click="CloseUpdate_Click"
                                ToolTip="关闭（Esc）" AutomationProperties.Name="关闭软件更新">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                        </Button>
                        <TextBlock Text="软件更新" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer x:Name="UpdateBodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel x:Name="UpdateCheckingPanel" Margin="0,20,0,24" Visibility="Collapsed">
                                <ui:ProgressRing Width="44" Height="44" IsIndeterminate="True"
                                                 CoverRingVisibility="Visible"
                                                 CoverRingStroke="{StaticResource Preview.Border}"
                                                 Foreground="{StaticResource Brush.Primary}" />
                                <TextBlock Text="正在检查更新…" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,24,0,8" />
                                <TextBlock Text="请稍候…" HorizontalAlignment="Center"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="UpdateResultPanel">
                                <Grid Margin="0,8,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="UpdateAppIcon" Source="pack://application:,,,/Assets/app.png"
                                           Width="44" Height="44" />
                                    <Border x:Name="UpdateStateIconBackground" Width="44" Height="44"
                                            CornerRadius="22" Background="{StaticResource Brush.Success}">
                                        <ui:SymbolIcon x:Name="UpdateStateIcon" Symbol="Checkmark24"
                                                       Foreground="White" FontSize="24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="UpdateStateTitle" FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="UpdateVersionText" FontSize="25" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource AncestorType=StackPanel}}" />
                                            <Border x:Name="UpdateVersionBadge" CornerRadius="4" Padding="7,3"
                                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Background="{StaticResource Brush.Primary.Surface}"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="发现新版本" FontSize="11"
                                                           Foreground="{StaticResource Brush.Primary}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock x:Name="UpdateInstalledVersionText" Margin="0,4,0,0"
                                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="UpdateResultMessage" TextWrapping="Wrap" Margin="0,0,0,16"
                                           Style="{StaticResource SecondaryTextStyle}" />
                                <Border x:Name="UpdateNotesPanel" Background="{StaticResource Brush.Surface.Option}"
                                        Padding="16,14,10,14" CornerRadius="{StaticResource Radius.Control}">
                                    <StackPanel>
                                        <TextBlock Text="更新内容" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <FlowDocumentScrollViewer x:Name="UpdateNotesViewer" MaxHeight="260"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  IsToolBarVisible="False" Zoom="100" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock x:Name="UpdateDownloadStatus" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Height="4"
                                     Visibility="Collapsed" Margin="0,0,0,12" />
                        <Button x:Name="DialogCheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click"
                                Style="{StaticResource Update.SecondaryButton}" Height="36" />
                        <Grid x:Name="UpdateAvailableActions">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ReleaseNotesButton" Content="查看更新说明" Click="ReleaseNotes_Click"
                                    Style="{StaticResource Update.SecondaryButton}" Height="36" Padding="8,0" />
                            <Button x:Name="LaterUpdateButton" Content="稍后" Click="CloseUpdate_Click"
                                    Visibility="Collapsed" Style="{StaticResource Update.SecondaryButton}"
                                    Height="36" Padding="8,0" />
                            <Button x:Name="CancelDownloadButton" Content="取消下载" Visibility="Collapsed"
                                    Click="CancelDownload_Click" Style="{StaticResource Update.SecondaryButton}"
                                    Height="36" Padding="8,0" />
                            <Button x:Name="DownloadUpdateButton" Grid.Column="2" Content="立即更新"
                                    Click="DownloadUpdate_Click" Style="{StaticResource Update.PrimaryButton}"
                                    Height="36" Padding="8,0" />
                            <Button x:Name="InstallUpdateButton" Grid.Column="2" Content="安装并重启"
                                    Visibility="Collapsed" Click="InstallUpdate_Click"
                                    Style="{StaticResource Update.PrimaryButton}" Height="36" Padding="8,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="OnboardingOverlay" Panel.ZIndex="220" Visibility="Collapsed" Background="Transparent"
              Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle" AllowDrop="True"
              PreviewDrop="Onboarding_BlockDrop" PreviewDragOver="Onboarding_BlockDrop"
              AutomationProperties.Name="新手指引">
            <Grid.Resources>
                <DataTemplate x:Key="Onboarding.ActionText">
                    <TextBlock Text="{Binding}"
                               FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                               FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </DataTemplate>
            </Grid.Resources>
            <Path x:Name="OnboardingDim" Fill="#42000000" IsHitTestVisible="False" />
            <Path x:Name="OnboardingOutline" Stroke="{StaticResource Brush.Primary.Border}" StrokeThickness="1"
                  IsHitTestVisible="False" />
            <Canvas IsHitTestVisible="False">
                <Border x:Name="OnboardingPulse" Visibility="Collapsed" CornerRadius="12" Width="24" Height="24"
                        BorderBrush="{StaticResource Brush.Primary}" BorderThickness="1.25"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                </Border>
                <Path x:Name="OnboardingArrow" Fill="{StaticResource Brush.Surface}" />
            </Canvas>
            <Border x:Name="OnboardingPopover" Width="312" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Padding="18" Background="{StaticResource Brush.Surface}"
                    CornerRadius="{StaticResource Radius.Section}" Effect="{StaticResource Effect.Surface.Light}"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                        <TextBlock x:Name="OnboardingCounter" DockPanel.Dock="Right" Margin="10,2,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="OnboardingTitle" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <TextBlock x:Name="OnboardingDescription" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OnboardingSkip" Content="跳过" HorizontalAlignment="Left"
                                ContentTemplate="{StaticResource Onboarding.ActionText}"
                                Padding="12,0" Height="34" FontSize="13" FontWeight="Normal"
                                Foreground="{StaticResource Brush.Text.Secondary}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OnboardingSkip_Click" AutomationProperties.Name="跳过新手指引" />
                        <Button x:Name="OnboardingPrevious" Grid.Column="1" Content="上一步" Margin="4,0,8,0"
                                ContentTemplate="{StaticResource Onboarding.ActionText}"
                                Padding="14,0" Height="34" FontSize="13" FontWeight="Normal"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OnboardingPrevious_Click" AutomationProperties.Name="上一步" />
                        <Button x:Name="OnboardingNext" Grid.Column="2" Content="下一步" Padding="14,0"
                                Width="88" Height="34" FontSize="13" FontWeight="SemiBold"
                                ContentTemplate="{StaticResource Onboarding.ActionText}"
                                Style="{StaticResource PrimaryButtonStyle}" Click="OnboardingNext_Click"
                                AutomationProperties.Name="下一步" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
