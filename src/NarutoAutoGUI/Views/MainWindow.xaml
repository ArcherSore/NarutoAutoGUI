<ui:FluentWindow x:Class="NarutoAutoGUI.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:NarutoAutoGUI.Views"
                 Title="NarutoAutoGUI"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1180"
                 Height="760"
                 MinWidth="920"
                 MinHeight="640"
                 Background="{StaticResource Brush.Canvas}"
                 Foreground="{StaticResource Brush.Text.Body}"
                 FontFamily="{StaticResource FontFamily.Ui}"
                 FontSize="{StaticResource FontSize.Body}"
                 ExtendsContentIntoTitleBar="True"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <views:LatestActivityConverter x:Key="Activity.IsLatest" />
        <Style x:Key="Activity.ClearButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Disabled}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="True" />
                        <Condition Property="IsPressed" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brush.Border.Subtle}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#A6B6CD" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <SolidColorBrush x:Key="Preview.Accent" Color="#2165E8" />
        <SolidColorBrush x:Key="Preview.Border" Color="#DCE6F5" />
        <SolidColorBrush x:Key="Preview.Surface" Color="#F2F6FB" />
        <Geometry x:Key="Preview.Monitor">M3,3 L21,3 Q23,3 23,5 L23,18 Q23,20 21,20
            L3,20 Q1,20 1,18 L1,5 Q1,3 3,3 M12,20 L12,24 M7,24 L17,24</Geometry>
        <DataTemplate x:Key="Preview.Empty">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="{StaticResource Preview.Monitor}" Width="34" Height="32" Stretch="Uniform"
                      Stroke="#B6C2D1" StrokeThickness="1.8" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Margin="0,0,0,14" />
                <TextBlock Text="暂无截图" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                           Foreground="{Binding Foreground,
                               RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                <TextBlock Text="请先连接运行环境" FontSize="11" TextAlignment="Center" Margin="0,6,0,0"
                           Foreground="#8A98AC" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="Preview.IconFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Preview.IconButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Preview.IconFocus}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Disabled}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Border}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Preview.DesktopButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Brush.Primary.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Preview.Accent}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="12,4" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Preview.Border}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Primary.SurfaceHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Primary.Border}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Tag" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Disabled}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Tag" Value="True" />
                        <Condition Property="IsPressed" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brush.Border}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Update.ButtonLabel">
            <TextBlock Text="{Binding}" FontWeight="SemiBold"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </DataTemplate>
        <Style x:Key="Update.PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource Update.ButtonLabel}" />
            <Setter Property="Background" Value="{StaticResource Preview.Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Preview.Accent}" />
        </Style>
        <Style x:Key="Update.SecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource Update.ButtonLabel}" />
            <Setter Property="Foreground" Value="{StaticResource Preview.Accent}" />
            <Setter Property="Background" Value="{StaticResource Brush.Primary.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Preview.Border}" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
    <Grid x:Name="MainWindowContent">
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=PreviewOverlay}" Value="Visible">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="12" KernelType="Gaussian" RenderingBias="Performance" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Visibility, ElementName=UpdateOverlay}" Value="Visible">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Performance" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <ui:TitleBar
                     Grid.Row="0"
                     Title="NarutoAutoGUI"
                     Background="{StaticResource Brush.Canvas}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="MainNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="168"
                           IsPaneOpen="True"
                           IsPaneVisible="True"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed"
                           IsTopSeparatorVisible="False"
                           HeaderVisibility="Collapsed"
                           FrameMargin="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="HomeNavigationItem"
                                       Content="首页"
                                       Icon="{ui:SymbolIcon Home24}"
                                       IsActive="True"
                                       Tag="Home"
                                       Click="NavigationItem_Click" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="UpdateNavigationItem" Click="ViewUpdate_Click">
                    <Grid>
                        <!-- Place the bell in NavigationViewItem's reserved icon slot. -->
                        <Grid Width="20" Height="20" Margin="-30,0,0,0" HorizontalAlignment="Left"
                              VerticalAlignment="Center" IsHitTestVisible="False">
                            <ui:SymbolIcon x:Name="UpdateNavigationIcon" Symbol="Alert24" FontSize="20" />
                            <Ellipse x:Name="UpdateNavigationBadge" Width="6" Height="6"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                     Fill="#F53F3F" Stroke="White" StrokeThickness="1" Visibility="Collapsed" />
                            <ui:ProgressRing x:Name="UpdateNavigationLoading" Width="14" Height="14"
                                             IsIndeterminate="True" Visibility="Collapsed"
                                             Foreground="{StaticResource Preview.Accent}" />
                        </Grid>
                        <TextBlock Text="更新" VerticalAlignment="Center" />
                    </Grid>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="SettingsNavigationItem"
                                       Content="设置"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       Tag="Settings"
                                       Click="NavigationItem_Click" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid Background="{StaticResource Brush.Canvas}">
                    <!-- Home and Settings intentionally remain in this single XAML namescope. -->
                    <Grid x:Name="HomeView">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="360" />
                            <ColumnDefinition x:Name="RuntimeSidebarColumn" Width="392" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Visibility="Collapsed">
                                <TextBlock x:Name="HomeRunContextTitleText" />
                                <TextBlock x:Name="HomeRunContextSubText" />
                            </StackPanel>
                    <Grid x:Name="TasksView" Grid.Row="1" Margin="16,12,16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="任务" Style="{StaticResource WindowTitleTextStyle}" />

                        <Border x:Name="ProjectValidationBorder"
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                Padding="12,8"
                                Background="{StaticResource Brush.Error.Surface}"
                                BorderBrush="{StaticResource Brush.Error.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ProjectValidationText"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Error.Foreground}"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       AutomationProperties.Name="任务配置校验结果"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Border>

                        <Border x:Name="ProjectEmptyStatePanel"
                                Grid.Row="2"
                                Margin="0,16,0,0"
                                Style="{StaticResource SettingsSectionPanelStyle}">
                            <StackPanel MaxWidth="460"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="ProjectEmptyStateTitleText"
                                           HorizontalAlignment="Center"
                                           Text="MaaNOP 项目无法加载"
                                           TextAlignment="Center"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="ProjectEmptyStateDetailText"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"
                                           Text="请使用完整的 MaaNOP 发布包，确保安装目录下直接包含 interface.json。"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="TaskWorkspacePanel"
                                      Grid.Row="2"
                                      Margin="0,12,0,0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <StackPanel Margin="0,0,8,24">
                                <Button x:Name="TaskShelfHeaderButton"
                                        Style="{StaticResource TaskShelfHeaderButtonStyle}"
                                        AutomationProperties.Name="展开或收起可用任务"
                                        Click="TaskShelfHeaderButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="可用任务" Style="{StaticResource SectionTitleTextStyle}" />
                                        <TextBlock x:Name="AvailableTaskCountText"
                                                   Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <ui:SymbolIcon x:Name="TaskShelfChevronIcon"
                                                       Grid.Column="2"
                                                       Width="16"
                                                       Height="16"
                                                       Symbol="ChevronUp16" />
                                    </Grid>
                                </Button>

                                <Border x:Name="TaskShelfContent"
                                        Margin="0,4,0,0"
                                        Padding="0,2,0,0"
                                        Style="{StaticResource TaskShelfSurfaceStyle}">
                                    <WrapPanel x:Name="AvailableTasksPanel" Orientation="Horizontal" />
                                </Border>

                                <Border Height="1"
                                        Margin="0,10,0,14"
                                        Background="{StaticResource Brush.Border}"
                                        SnapsToDevicePixels="True" />

                                <TextBlock Text="执行计划" Style="{StaticResource SectionTitleTextStyle}" />
                                <StackPanel x:Name="PlanItemsPanel"
                                            Margin="0,10,0,0"
                                            AllowDrop="True"
                                            DragLeave="PlanItemsPanel_DragLeave"
                                            DragOver="PlanItemsPanel_DragOver"
                                            Drop="PlanItemsPanel_Drop" />

                                <StackPanel x:Name="EmptyPlanPanel" Margin="0,16,0,0">
                                    <TextBlock Text="执行计划为空" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="从上方可用任务中点击 + 添加任务"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                        </Grid>
                        <Grid x:Name="RuntimeSidebar" Grid.Column="1" Margin="0,12,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="0,0,0,10" Padding="22,5"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Preview.Border}" BorderThickness="1"
                                    Effect="{StaticResource Effect.Surface.Light}">
                                <Border.Resources>
                                    <Style x:Key="RuntimeActionIconButtonStyle" TargetType="{x:Type Button}"
                                           BasedOn="{StaticResource CompactIconButtonStyle}">
                                        <Setter Property="Width" Value="32" />
                                        <Setter Property="Height" Value="32" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="{StaticResource Brush.Primary.Surface}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary.Border}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border CornerRadius="100" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="{StaticResource Preview.Accent}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource Brush.Primary.SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.7" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Resources>
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="运行控制" VerticalAlignment="Center"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#0F172A" />
                                    <Button x:Name="PrepareEnvironmentButton" Grid.Column="1"
                                            Style="{StaticResource RuntimeActionIconButtonStyle}"
                                            ToolTip="准备运行环境" AutomationProperties.Name="准备运行环境"
                                            Click="PrepareEnvironmentButton_Click">
                                        <ui:SymbolIcon Width="20" Height="20" FontSize="20"
                                                       Foreground="{StaticResource Preview.Accent}" Symbol="Power24" />
                                    </Button>
                                    <Button x:Name="RetryEnvironmentButton" Grid.Column="1"
                                            Visibility="Collapsed" Style="{StaticResource RuntimeActionIconButtonStyle}"
                                            ToolTip="重试" AutomationProperties.Name="重试运行环境"
                                            Click="RetryRuntimeHeaderButton_Click">
                                        <ui:SymbolIcon Width="20" Height="20" FontSize="20"
                                                       Foreground="{StaticResource Preview.Accent}"
                                                       Symbol="ArrowClockwise24" />
                                    </Button>
                                    <Button x:Name="StartTaskHeaderButton" Grid.Column="1"
                                            Visibility="Collapsed" Style="{StaticResource RuntimeActionIconButtonStyle}"
                                            ToolTip="开始任务" AutomationProperties.Name="开始任务"
                                            Click="StartRunButton_Click">
                                        <ui:SymbolIcon Width="20" Height="20" FontSize="20"
                                                       Foreground="{StaticResource Preview.Accent}" Symbol="Play24" />
                                    </Button>
                                    <Button x:Name="StopTaskHeaderButton" Grid.Column="1"
                                            Visibility="Collapsed" Style="{StaticResource RuntimeActionIconButtonStyle}"
                                            ToolTip="停止任务" AutomationProperties.Name="停止任务"
                                            Click="StopRunButton_Click">
                                        <ui:SymbolIcon Width="20" Height="20" FontSize="20"
                                                       Foreground="{StaticResource Preview.Accent}" Symbol="Stop24" />
                                    </Button>
                                    <ui:ProgressRing x:Name="RuntimeHeaderProgressRing" Grid.Column="1"
                                                     Width="18" Height="18" Margin="0,0,9,0"
                                                     VerticalAlignment="Center" Visibility="Collapsed"
                                                     IsIndeterminate="True"
                                                     ToolTip="正在准备运行环境"
                                                     AutomationProperties.Name="正在准备运行环境" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Margin="0,0,0,10"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Preview.Border}" BorderThickness="1"
                                    Effect="{StaticResource Effect.Surface.Light}">
                                <StackPanel>
                                    <Grid Margin="16,10,12,10" Height="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource Preview.Monitor}" Width="16" Height="16"
                                              Stretch="Uniform" Stroke="{StaticResource Preview.Accent}"
                                              StrokeThickness="1.8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="实时截图" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#0F172A" />
                                        <Button x:Name="ExpandPreviewButton" Grid.Column="2"
                                                Style="{StaticResource Preview.IconButton}"
                                                ToolTip="放大实时截图" AutomationProperties.Name="放大实时截图"
                                                Click="ExpandPreview_Click">
                                            <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="2"
                                                  Stroke="{StaticResource Brush.Text.Secondary}"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M7,1 L2,1 Q1,1 1,2 L1,7 M17,1 L22,1 Q23,1 23,2 L23,7
                                                        M1,17 L1,22 Q1,23 2,23 L7,23
                                                        M17,23 L22,23 Q23,23 23,22 L23,17" />
                                        </Button>
                                        <Border Grid.Column="3" Width="1" Height="14" Margin="4,0"
                                                Background="{StaticResource Preview.Border}" />
                                        <Button Grid.Column="4" Style="{StaticResource Preview.IconButton}"
                                                ToolTip="展开或收起实时截图" AutomationProperties.Name="展开或收起实时截图"
                                                Click="TogglePreview_Click">
                                            <ui:SymbolIcon x:Name="PreviewChevron" Symbol="ChevronUp16" FontSize="16" />
                                        </Button>
                                    </Grid>
                                    <StackPanel x:Name="PreviewCardContent" Margin="10,0,10,10">
                                        <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                            <Border Width="360" Height="178" ClipToBounds="True"
                                                    Background="{StaticResource Preview.Surface}"
                                                    BorderBrush="{StaticResource Preview.Border}" BorderThickness="0.6">
                                                <Grid>
                                                    <Image x:Name="HomePreviewImage" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="Collapsed" />
                                                    <ContentControl x:Name="HomePreviewPlaceholder"
                                                                    ContentTemplate="{StaticResource Preview.Empty}"
                                                                    Foreground="#526077" />
                                                </Grid>
                                            </Border>
                                        </Viewbox>
                                        <Button x:Name="HomeDesktopVisibilityButton" Margin="0,10,0,0"
                                                HorizontalAlignment="Right" IsEnabled="False"
                                                Style="{StaticResource Preview.DesktopButton}"
                                                AutomationProperties.Name="显示分身" ToolTip="显示分身"
                                                Click="HomeDesktopVisibilityButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="20" Height="20" Margin="0,0,7,0">
                                                    <Path Width="24" Height="24" StrokeThickness="2"
                                                          Stroke="{Binding Foreground,
                                                              RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round">
                                                        <Path.Style>
                                                            <Style TargetType="{x:Type Path}">
                                                                <Setter Property="Data"
                                                                        Value="M9,19 L4,19 Q2,19 2,17 L2,4 Q2,2 4,2
                                                                               L19,2 Q21,2 21,4 L21,9
                                                                               M9,16 Q16,7 23,16 Q16,25 9,16 Z
                                                                               M18,16 A2,2 0 1 1 14,16
                                                                               A2,2 0 1 1 18,16" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True"
                                                                        Binding="{Binding Tag,
                                                                            RelativeSource={RelativeSource
                                                                                AncestorType=Button}}">
                                                                        <Setter Property="Data"
                                                                            Value="M3,3 L21,21 M9,5 Q17,2 23,12
                                                                                   Q21,16 19,17 M15,19 Q7,22 1,12
                                                                                   Q3,8 5,7 M9,9 A4,4 0 0 0 15,15" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Viewbox>
                                                <AccessText x:Name="HomeDesktopVisibilityText" Text="显示分身"
                                                            VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Visibility="Collapsed">
                                        <TextBlock x:Name="HomeSessionStatusText" />
                                        <StackPanel x:Name="HomeSessionStatusPanel">
                                            <Ellipse x:Name="HomeSessionStatusIndicator" Width="6" Height="6" />
                                        </StackPanel>
                                        <TextBlock x:Name="HomeSessionHintText" />
                                        <MenuItem x:Name="HomeTerminateSessionMenuItem" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Preview.Border}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Control}">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="ClearActivityButton" ToolTip="清空面板中的运行动态"
                                                    Style="{StaticResource Activity.ClearButton}"
                                                    Click="ClearActivity_Click"
                                                    IsEnabled="{Binding HasItems, ElementName=HomeLogListBox}"
                                                    AutomationProperties.Name="清空运行动态">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="12" Height="14" Stretch="Uniform" Margin="0,0,5,0"
                                                          Stroke="{Binding Foreground,
                                                              RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.6" StrokeLineJoin="Round"
                                                          Data="M3,6 L21,6 M9,6 L9,3 L15,3 L15,6
                                                                M5,6 L6,22 L18,22 L19,6 M10,10 L10,18 M14,10 L14,18" />
                                                    <TextBlock Text="清空" FontSize="11"
                                                               Foreground="{Binding Foreground,
                                                                   RelativeSource={RelativeSource
                                                                       AncestorType=Button}}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="运行动态" VerticalAlignment="Center"
                                                   Style="{StaticResource SectionTitleTextStyle}" />
                                    </DockPanel>
                                    <Grid Grid.Row="1">
                                        <ListBox x:Name="HomeLogListBox" ItemsSource="{Binding LogLines}"
                                                 Style="{StaticResource LogListBoxStyle}"
                                                 Background="{StaticResource Brush.Surface}"
                                                 BorderThickness="0" Padding="0"
                                                 FontFamily="{StaticResource FontFamily.Ui}"
                                                 VirtualizingPanel.ScrollUnit="Item"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="运行动态"
                                                 AutomationProperties.HelpText="最新动态在顶部，仅显示 MaaNOP 用户运行日志">
                                            <ListBox.Resources>
                                                <Style TargetType="{x:Type ScrollBar}">
                                                    <Setter Property="Width" Value="8" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                                <Grid Background="#F6F8FB" Width="8"
                                                                      HorizontalAlignment="Right">
                                                                    <Track x:Name="PART_Track" Orientation="Vertical"
                                                                           IsDirectionReversed="True">
                                                                        <Track.Thumb>
                                                                            <Thumb MinHeight="20">
                                                                                <Thumb.Template>
                                                                                    <ControlTemplate TargetType="Thumb">
                                                                                        <Border Margin="1"
                                                                                            CornerRadius="3"
                                                                                            Background="#A6B6CD" />
                                                                                    </ControlTemplate>
                                                                                </Thumb.Template>
                                                                            </Thumb>
                                                                        </Track.Thumb>
                                                                    </Track>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.Resources>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}"
                                                       BasedOn="{StaticResource LogListBoxItemStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding
                                                                    Converter="{StaticResource Activity.IsLatest}">
                                                                    <Binding />
                                                                    <Binding Path="ItemsSource[0]"
                                                                             RelativeSource="{RelativeSource
                                                                        AncestorType=ListBox}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource Brush.Primary.Surface}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border MinHeight="28" Padding="6,5"
                                                            BorderBrush="#EDF2F8" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="12" Foreground="#667FA5" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                                       Foreground="{StaticResource Brush.Text.Primary}"
                                                                       FontSize="12" TextWrapping="Wrap"
                                                                       AutomationProperties.HelpText="{Binding
                                                                           DisplayLevel}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Grid IsHitTestVisible="False">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems,
                                                            ElementName=HomeLogListBox}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                                                <StackPanel Width="300" HorizontalAlignment="Center">
                                                    <Grid Width="72" Height="64" Margin="0,0,0,8">
                                                        <Ellipse Width="64" Height="64" Fill="#F1F6FD" />
                                                        <Border Width="34" Height="34" CornerRadius="4"
                                                                Background="#C4D6EE" VerticalAlignment="Center">
                                                            <Path Margin="7" Stroke="White" StrokeThickness="3"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Data="M0,3 L20,3 M0,10 L20,10 M0,17 L12,17" />
                                                        </Border>
                                                        <Ellipse Width="4" Height="4" Fill="#CBDDF5"
                                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                 Margin="0,15,0,0" />
                                                        <Path Fill="#CBDDF5" HorizontalAlignment="Right"
                                                              VerticalAlignment="Top" Data="M4,0 L5,3 L8,4 L5,5
                                                                                              L4,8 L3,5 L0,4 L3,3 Z" />
                                                    </Grid>
                                                    <TextBlock Text="暂无运行动态" TextAlignment="Center"
                                                               Style="{StaticResource SectionTitleTextStyle}" />
                                                    <TextBlock Text="任务开始后，将在此处显示关键状态更新"
                                                               TextAlignment="Center" Margin="0,6,0,0" FontSize="11"
                                                               Foreground="#667FA5" />
                                                </StackPanel>
                                            </Viewbox>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="SettingsView"
                                  Visibility="Collapsed"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="设置" Style="{StaticResource WindowTitleTextStyle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="管理 MaaNOP 更新与应用行为。"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,24,0,24">
                                <TextBlock Text="更新" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="UpdateCurrentVersionText" Margin="0,12,0,12" Text="当前版本：—" />
                                <CheckBox x:Name="StartupUpdateCheck" Content="启动时检查更新" IsChecked="True"
                                          Click="StartupUpdateCheck_Click" Margin="0,0,0,12" />
                                <Button x:Name="CheckUpdateButton" Content="检查更新" HorizontalAlignment="Left"
                                        Click="CheckUpdate_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                <TextBlock x:Name="UpdateCheckStatus" Margin="0,12,0,24" TextWrapping="Wrap" />
                                <Border Height="1"
                                        Margin="0,0,0,24"
                                        Background="{StaticResource Brush.Border}"
                                        SnapsToDevicePixels="True" />
                                <TextBlock Text="应用行为" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Margin="0,10,0,0"
                                           Text="关闭主窗口时会隐藏到系统托盘，任务与桌面分身继续运行。请使用托盘菜单中的“退出程序”完成清理。"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Grid x:Name="TaskDescriptionOverlay"
                          Panel.ZIndex="100"
                          Visibility="Collapsed"
                          AutomationProperties.Name="任务描述">
                        <Button Background="{StaticResource Brush.Overlay.Dim}"
                                BorderThickness="0"
                                Focusable="False"
                                Click="TaskDescriptionScrim_Click" />
                        <Border Width="420"
                                MaxWidth="420"
                                HorizontalAlignment="Right"
                                Style="{StaticResource TaskDescriptionDrawerStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TaskDescriptionDrawerTitle"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource StatusPrimaryTextStyle}" />
                                    <Button x:Name="TaskDescriptionCloseButton"
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Style="{StaticResource CompactIconButtonStyle}"
                                            AutomationProperties.Name="关闭任务描述"
                                            Click="TaskDescriptionCloseButton_Click">
                                        <ui:SymbolIcon Width="16" Height="16" Symbol="Dismiss16" />
                                    </Button>
                                </Grid>
                                <Border Grid.Row="1"
                                        Height="1"
                                        Margin="0,14,0,14"
                                        Background="{StaticResource Brush.Border}" />
                                <ScrollViewer Grid.Row="2"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TaskDescriptionDrawerText"
                                               Margin="0,0,8,0"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <Border Grid.Row="2"
                Padding="16,0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="GlobalReadyIndicator"
                             Width="6"
                             Height="6"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource Brush.Text.Muted}" />
                    <TextBlock x:Name="GlobalReadyText"
                               Text="整体：尚未就绪"
                               Style="{StaticResource MonospaceMetaTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="GlobalWorkerIndicator"
                             Width="6"
                             Height="6"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource Brush.Text.Muted}" />
                    <TextBlock x:Name="GlobalWorkerStatusText"
                               Text="Worker：尚未启动"
                               Style="{StaticResource MonospaceMetaTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="GlobalSessionIndicator"
                             Width="6"
                             Height="6"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource Brush.Text.Muted}" />
                    <TextBlock x:Name="GlobalSessionStatusText"
                               Text="Session：未运行"
                               Style="{StaticResource MonospaceMetaTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="GlobalIpcIndicator"
                             Width="6"
                             Height="6"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource Brush.Text.Muted}" />
                    <TextBlock x:Name="GlobalIpcStatusText"
                               Text="IPC：未连接"
                               Style="{StaticResource MonospaceMetaTextStyle}" />
                </StackPanel>

                <TextBlock x:Name="OperationStatusText"
                           Grid.Column="4"
                           Margin="24,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="就绪"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource SecondaryTextStyle}"
                           AutomationProperties.Name="操作状态"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="OperationProgressBar"
                             Grid.Column="5"
                             Width="120"
                             Height="4"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             IsTabStop="False"
                             AutomationProperties.Name="操作正在进行" />
            </Grid>
        </Border>
    </Grid>
        <Grid x:Name="PreviewOverlay" Panel.ZIndex="200" Visibility="Collapsed"
              Focusable="True" KeyboardNavigation.TabNavigation="Cycle" SizeChanged="PreviewOverlay_SizeChanged"
              KeyboardNavigation.ControlTabNavigation="Cycle" AutomationProperties.Name="放大实时截图">
            <Button x:Name="PreviewScrim" Background="#300F172A" BorderThickness="0"
                    Focusable="False" IsTabStop="False" Click="ClosePreview_Click"
                    AutomationProperties.Name="关闭放大截图遮罩">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border x:Name="ExpandedPreviewCard" Margin="40" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="{StaticResource Brush.Canvas}"
                    BorderBrush="{StaticResource Preview.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Section}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.2" Color="#0F172A" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Brush.Surface}" Padding="16,0"
                            BorderBrush="{StaticResource Preview.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button x:Name="ClosePreviewButton" DockPanel.Dock="Right"
                                    Style="{StaticResource Preview.IconButton}"
                                    ToolTip="关闭（Esc）" AutomationProperties.Name="关闭放大截图"
                                    Click="ClosePreview_Click">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16"
                                               Foreground="{StaticResource Brush.Text.Secondary}" />
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Preview.Monitor}" Width="16" Height="16"
                                      Stretch="Uniform" Stroke="{StaticResource Preview.Accent}"
                                      StrokeThickness="1.8" Margin="0,0,8,0" />
                                <TextBlock Text="实时截图" Foreground="{StaticResource Brush.Text.Primary}"
                                           FontWeight="SemiBold" />
                                <Border Background="#00854A" Padding="6,2" Margin="12,0,0,0" CornerRadius="3"
                                        Visibility="{Binding Visibility, ElementName=HomePreviewImage}">
                                    <TextBlock Text="● LIVE" Foreground="White" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="8">
                        <Image Source="{Binding Source, ElementName=HomePreviewImage}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <ContentControl ContentTemplate="{StaticResource Preview.Empty}"
                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                        Visibility="{Binding Visibility, ElementName=HomePreviewPlaceholder}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="UpdateOverlay" Panel.ZIndex="210" Visibility="Collapsed" Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              SizeChanged="UpdateOverlay_SizeChanged"
              AutomationProperties.Name="软件更新">
            <Button Background="#59111927" BorderThickness="0" Focusable="False" IsTabStop="False"
                    Click="CloseUpdate_Click" AutomationProperties.Name="关闭软件更新遮罩">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border x:Name="UpdateDialog" Width="360" MaxHeight="600" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Preview.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Section}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.2" Color="#0F172A" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,-8,-8,16">
                        <Button x:Name="CloseUpdateButton" DockPanel.Dock="Right"
                                Style="{StaticResource Preview.IconButton}" Click="CloseUpdate_Click"
                                ToolTip="关闭（Esc）" AutomationProperties.Name="关闭软件更新">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                        </Button>
                        <TextBlock Text="软件更新" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer x:Name="UpdateBodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel x:Name="UpdateCheckingPanel" Margin="0,20,0,24" Visibility="Collapsed">
                                <ui:ProgressRing Width="44" Height="44" IsIndeterminate="True"
                                                 CoverRingVisibility="Visible"
                                                 CoverRingStroke="{StaticResource Preview.Border}"
                                                 Foreground="{StaticResource Preview.Accent}" />
                                <TextBlock Text="正在检查更新…" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,24,0,8" />
                                <TextBlock Text="请稍候…" HorizontalAlignment="Center"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="UpdateResultPanel">
                                <Grid Margin="0,8,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="UpdateAppIcon" Source="pack://application:,,,/Assets/app.png"
                                           Width="48" Height="48" />
                                    <Border x:Name="UpdateStateIconBackground" Width="44" Height="44"
                                            CornerRadius="22" Background="{StaticResource Brush.Success}">
                                        <ui:SymbolIcon x:Name="UpdateStateIcon" Symbol="Checkmark24"
                                                       Foreground="White" FontSize="24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="UpdateStateTitle" FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock x:Name="UpdateVersionText" FontSize="22" FontWeight="SemiBold"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="UpdateInstalledVersionText" Margin="0,4,0,0"
                                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="UpdateResultMessage" TextWrapping="Wrap" Margin="0,0,0,16"
                                           Style="{StaticResource SecondaryTextStyle}" />
                                <Border x:Name="UpdateNotesPanel" Background="{StaticResource Brush.Surface.Option}"
                                        Padding="12" CornerRadius="{StaticResource Radius.Control}">
                                    <StackPanel>
                                        <TextBlock Text="更新内容" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <FlowDocumentScrollViewer x:Name="UpdateNotesViewer" MaxHeight="220"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  IsToolBarVisible="False" Zoom="100" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock x:Name="UpdateDownloadStatus" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Height="4"
                                     Visibility="Collapsed" Margin="0,0,0,12" />
                        <Button x:Name="DialogCheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click"
                                Style="{StaticResource Update.SecondaryButton}" Height="36" />
                        <Grid x:Name="UpdateAvailableActions">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ReleaseNotesButton" Content="查看更新说明" Click="ReleaseNotes_Click"
                                    Style="{StaticResource Update.SecondaryButton}" Height="36" Padding="8,0" />
                            <Button x:Name="CancelDownloadButton" Content="取消下载" Visibility="Collapsed"
                                    Click="CancelDownload_Click" Style="{StaticResource Update.SecondaryButton}"
                                    Height="36" Padding="8,0" />
                            <Button x:Name="DownloadUpdateButton" Grid.Column="2" Content="立即更新"
                                    Click="DownloadUpdate_Click" Style="{StaticResource Update.PrimaryButton}"
                                    Height="36" Padding="8,0" />
                            <Button x:Name="InstallUpdateButton" Grid.Column="2" Content="安装并重启"
                                    Visibility="Collapsed" Click="InstallUpdate_Click"
                                    Style="{StaticResource Update.PrimaryButton}" Height="36" Padding="8,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
