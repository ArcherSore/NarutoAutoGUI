<Window x:Class="NarutoAutoGUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NarutoAutoGUI"
        Width="1040"
        Height="760"
        MinWidth="860"
        MinHeight="660"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFF3F7FC" BorderBrush="#FFD5E2F0" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="桌面分身" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="SessionStatusText" Text="正在检测..." Margin="0,5,0,0" />
                    <TextBlock x:Name="SessionIdText" Text="childSessionId: —" Foreground="#FF58616B" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="固定 1920 × 1080  ·  100%" VerticalAlignment="Center"
                           Foreground="#FF385A7C" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <GroupBox Grid.Row="1" Header="Child Session">
            <WrapPanel>
                <Button x:Name="CreateSessionButton" Content="创建 / 恢复" Click="CreateSessionButton_Click" />
                <Button x:Name="ShowSessionButton" Content="显示子桌面" Click="ShowSessionButton_Click" />
                <Button x:Name="HideSessionButton" Content="隐藏子桌面" Click="HideSessionButton_Click" />
                <Button x:Name="TerminateSessionButton" Content="结束桌面分身" Click="TerminateSessionButton_Click" />
            </WrapPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="程序启动">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="游戏程序" Target="{Binding ElementName=GamePathTextBox}"
                       VerticalAlignment="Center" Padding="0" Margin="0,0,8,8" />
                <TextBox x:Name="GamePathTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8"
                         ToolTip="游戏 exe 路径" LostKeyboardFocus="PathsTextBox_LostKeyboardFocus" />
                <Button Grid.Row="0" Grid.Column="2" Content="浏览..." Click="BrowseGameButton_Click" />
                <Button x:Name="LaunchGameButton" Grid.Row="0" Grid.Column="3" Content="启动游戏"
                        Click="LaunchGameButton_Click" />

                <Label Grid.Row="1" Content="启动参数" Target="{Binding ElementName=GameArgumentsTextBox}"
                       VerticalAlignment="Center" Padding="0" Margin="0,0,8,8" />
                <TextBox x:Name="GameArgumentsTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                         Margin="0,0,0,8" ToolTip="传递给游戏启动程序的命令行参数"
                         AutomationProperties.HelpText="火影忍者 Online 使用 -/appid:1103286479"
                         LostKeyboardFocus="PathsTextBox_LostKeyboardFocus" />

                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,10"
                           Foreground="#FF58616B" TextWrapping="Wrap"
                           Text="火影忍者 Online 默认通过 QQMicroGameBox\Launch.exe 和 appid 参数启动；工作目录自动使用 exe 所在目录。" />

                <Label Grid.Row="3" Content="MaaNOP" Target="{Binding ElementName=MaaNopPathTextBox}"
                       VerticalAlignment="Center" Padding="0" Margin="0,0,8,8" />
                <TextBox x:Name="MaaNopPathTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,8,8"
                         ToolTip="MaaNOP exe 路径" LostKeyboardFocus="PathsTextBox_LostKeyboardFocus" />
                <Button Grid.Row="3" Grid.Column="2" Content="浏览..." Click="BrowseMaaNopButton_Click" />
                <Button x:Name="LaunchMaaNopButton" Grid.Row="3" Grid.Column="3" Content="启动 MaaNOP"
                        Click="LaunchMaaNopButton_Click" />

                <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <Button x:Name="LaunchAllButton" Content="一键启动挂机环境" FontWeight="SemiBold"
                            Padding="24,9" Click="LaunchAllButton_Click" />
                    <TextBlock Text="恢复/创建 → 显示 → 游戏 → MaaNOP → 保持显示"
                               VerticalAlignment="Center" Foreground="#FF58616B" Margin="6,0,0,8" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="日志（INFO+）" Margin="0,0,0,8">
            <Grid>
                <ListBox x:Name="LogListBox" ItemsSource="{Binding LogLines}" FontFamily="Consolas"
                         FontSize="12" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="OperationStatusText" Text="就绪" Foreground="#FF58616B" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="打开日志目录" Padding="10,4" MinHeight="28"
                    Click="OpenLogsButton_Click" />
            <TextBlock Grid.Column="2" Text="关闭主窗口将隐藏到托盘" Foreground="#FF7A828A"
                       VerticalAlignment="Center" Margin="8,0,0,8" />
        </Grid>
    </Grid>
</Window>
