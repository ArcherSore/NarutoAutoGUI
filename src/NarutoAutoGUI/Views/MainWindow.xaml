<ui:FluentWindow x:Class="NarutoAutoGUI.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:NarutoAutoGUI.Views"
                 xmlns:models="clr-namespace:NarutoAutoGUI.Models"
                 Title="NarutoAutoGUI"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1180"
                 Height="760"
                 MinWidth="920"
                 MinHeight="640"
                 Background="{StaticResource Brush.Canvas}"
                 Foreground="{StaticResource Brush.Text.Body}"
                 FontFamily="{StaticResource FontFamily.Ui}"
                 FontSize="{StaticResource FontSize.Body}"
                 ExtendsContentIntoTitleBar="True"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <views:ScrollEdgeVisibilityConverter x:Key="Scroll.EdgeVisibility" />
        <Style x:Key="Rail.Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=views:RailItem}}" />
            <Setter Property="FontWeight"
                    Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=views:RailItem}}" />
        </Style>
        <Style x:Key="Rail.Item" TargetType="views:RailItem">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="views:RailItem">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Indicator" Width="3" Height="20" Margin="-5,0,0,0" CornerRadius="1.5"
                                    HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{StaticResource Brush.Primary}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Rail.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsActive" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Rail.Active}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Configuration tabs are segments on one tinted bar. The scroll bar stays hidden; edge fades show where
             more tabs are clipped, and the add button sits outside the scroller. -->
        <Color x:Key="Configuration.BarColor">#E9EDF3</Color>
        <Color x:Key="Configuration.BarColor.Clear">#00E9EDF3</Color>
        <LinearGradientBrush x:Key="Configuration.FadeLeft" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="{StaticResource Configuration.BarColor}" />
            <GradientStop Offset="1" Color="{StaticResource Configuration.BarColor.Clear}" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Configuration.FadeRight" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="{StaticResource Configuration.BarColor.Clear}" />
            <GradientStop Offset="1" Color="{StaticResource Configuration.BarColor}" />
        </LinearGradientBrush>
        <ControlTemplate x:Key="Configuration.Scroll" TargetType="ScrollViewer">
            <Grid>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" />
                <Border x:Name="LeftFade" Width="28" HorizontalAlignment="Left" IsHitTestVisible="False"
                        Background="{StaticResource Configuration.FadeLeft}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource Scroll.EdgeVisibility}" ConverterParameter="Left">
                            <Binding Path="HorizontalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ScrollableWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
                <Border x:Name="RightFade" Width="28" HorizontalAlignment="Right" IsHitTestVisible="False"
                        Background="{StaticResource Configuration.FadeRight}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource Scroll.EdgeVisibility}" ConverterParameter="Right">
                            <Binding Path="HorizontalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ScrollableWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
            </Grid>
        </ControlTemplate>
        <Style x:Key="Configuration.Bar" TargetType="Border">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource Configuration.BarColor}" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Configuration.Tab" TargetType="TabItem">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MaxWidth" Value="200" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Segment" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" Margin="11,0,4,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#8CFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Segment" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270"
                                                          Opacity="0.14" Color="#182230" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush"
                                        Value="{StaticResource Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Configuration.Add" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Configuration.Delete" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TabItem}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                    <Setter Property="Background" Value="{StaticResource Brush.Error.Surface}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Background" Value="{StaticResource Brush.Error.Surface}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <views:LatestActivityConverter x:Key="Activity.IsLatest" />
        <Style x:Key="Activity.ClearButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Disabled}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="True" />
                        <Condition Property="IsPressed" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brush.Border.Subtle}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#A6B6CD" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <LinearGradientBrush x:Key="Scroll.FadeTop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="{StaticResource Color.Neutral.50}" />
            <GradientStop Offset="1" Color="{StaticResource Color.Neutral.50.Clear}" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Scroll.FadeBottom" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="{StaticResource Color.Neutral.50.Clear}" />
            <GradientStop Offset="1" Color="{StaticResource Color.Neutral.50}" />
        </LinearGradientBrush>
        <!-- Canvas scroll areas: overlay thin scrollbar in the right gutter, edges fade while more content exists. -->
        <ControlTemplate x:Key="Scroll.Faded" TargetType="ScrollViewer">
            <Grid>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        CanContentScroll="{TemplateBinding CanContentScroll}" />
                <Border x:Name="TopFade" Height="{StaticResource Height.ScrollFade}" VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Background="{StaticResource Scroll.FadeTop}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource Scroll.EdgeVisibility}" ConverterParameter="Top">
                            <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
                <Border x:Name="BottomFade" Height="{StaticResource Height.ScrollFade}" VerticalAlignment="Bottom"
                        IsHitTestVisible="False"
                        Background="{StaticResource Scroll.FadeBottom}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource Scroll.EdgeVisibility}" ConverterParameter="Bottom">
                            <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
                <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Minimum="0"
                           Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{Binding VerticalOffset, Mode=OneWay,
                               RelativeSource={RelativeSource TemplatedParent}}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
        </ControlTemplate>
        <SolidColorBrush x:Key="Preview.Border" Color="#DCE6F5" />
        <SolidColorBrush x:Key="Preview.Surface" Color="#F2F6FB" />
        <Geometry x:Key="Preview.Monitor">M3,3 L21,3 Q23,3 23,5 L23,18 Q23,20 21,20
            L3,20 Q1,20 1,18 L1,5 Q1,3 3,3 M12,20 L12,24 M7,24 L17,24</Geometry>
        <Geometry x:Key="Preview.Expand">M7,1 L2,1 Q1,1 1,2 L1,7 M17,1 L22,1 Q23,1 23,2 L23,7
            M1,17 L1,22 Q1,23 2,23 L7,23 M17,23 L22,23 Q23,23 23,22 L23,17</Geometry>
        <Style x:Key="Preview.ExpandIcon" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource Preview.Expand}" />
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        </Style>
        <DataTemplate x:Key="Preview.Empty">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="{StaticResource Preview.Monitor}" Width="34" Height="32" Stretch="Uniform"
                      Stroke="#B6C2D1" StrokeThickness="1.8" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                           FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                           Foreground="{Binding Foreground,
                               RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                <TextBlock Text="{Binding}" FontSize="11" TextAlignment="Center" Margin="0,6,0,0"
                           Foreground="#8A98AC" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="Preview.IconFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Preview.IconButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Preview.IconFocus}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Disabled}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Border}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Runtime console: one card whose sections are divided by hairlines. -->
        <Style x:Key="Console.Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.06"
                                      Color="#182230" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Console.Section" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style x:Key="Console.SectionHeader" TargetType="Grid">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="16,0,8,0" />
        </Style>
        <Style x:Key="Console.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        </Style>
        <Style x:Key="Console.Pill" TargetType="Border">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8,0,9,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Console.ButtonText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="Console.PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="Console.NeutralButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Subdued}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Console.DangerButton" TargetType="Button" BasedOn="{StaticResource Console.NeutralButton}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Error.Foreground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Error.Border}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Error.Surface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Error}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Shortcuts over the live picture appear while it is hovered or holds keyboard focus. -->
        <Style x:Key="Preview.Overlay" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Visibility, ElementName=HomePreviewImage}" Value="Visible" />
                        <Condition Binding="{Binding IsMouseOver, ElementName=PreviewCardContent}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="1" />
                </MultiDataTrigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Preview.OverlayButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#A80A0E14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D90A0E14" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Update.ButtonLabel">
            <TextBlock Text="{Binding}" FontWeight="SemiBold"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </DataTemplate>
        <Style x:Key="Update.PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource Update.ButtonLabel}" />
        </Style>
        <Style x:Key="Update.SecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource Update.ButtonLabel}" />
            <Setter Property="Background" Value="{StaticResource Brush.Primary.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Preview.Border}" />
        </Style>
        <!-- Parameter editors share one height. The implicit TextBlock style keeps disabled caption text dark,
             so a locked dropdown or switch fades as a whole; the text box has its own disabled colours. -->
        <Style x:Key="Option.TextBox" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,5,10,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClearButtonEnabled" Value="False" />
        </Style>
        <Style x:Key="Option.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,5,10,5" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Option.ToggleSwitch" TargetType="ui:ToggleSwitch"
               BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid x:Name="WindowOverlayRoot">
    <Grid x:Name="MainWindowContent">
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=PreviewOverlay}" Value="Visible">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="12" KernelType="Gaussian" RenderingBias="Performance" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Visibility, ElementName=UpdateOverlay}" Value="Visible">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Performance" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
                     Grid.Row="0"
                     Title="NarutoAutoGUI"
                     Background="{StaticResource Brush.Canvas}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- A fixed 64 px rail on every page: icon above label, home on top, update and settings at the bottom. -->
            <Border x:Name="MainNavigation" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Rail.Border}"
                    Background="{StaticResource Brush.Canvas}" AutomationProperties.Name="导航">
                <DockPanel Margin="0,6,0,10">
                    <views:RailItem x:Name="HomeNavigationItem" DockPanel.Dock="Top" Tag="Home" IsActive="True"
                                    Style="{StaticResource Rail.Item}" ToolTip="首页"
                                    AutomationProperties.Name="首页" Click="NavigationItem_Click">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Home24" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="首页" Style="{StaticResource Rail.Label}" />
                        </StackPanel>
                    </views:RailItem>
                    <views:RailItem x:Name="SettingsNavigationItem" DockPanel.Dock="Bottom" Tag="Settings"
                                    Style="{StaticResource Rail.Item}" ToolTip="设置"
                                    AutomationProperties.Name="设置" Click="NavigationItem_Click">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Settings24" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="设置" Style="{StaticResource Rail.Label}" />
                        </StackPanel>
                    </views:RailItem>
                    <views:RailItem x:Name="UpdateNavigationItem" DockPanel.Dock="Bottom"
                                    Style="{StaticResource Rail.Item}" Click="ViewUpdate_Click">
                        <StackPanel>
                            <Grid Width="20" Height="20" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <ui:SymbolIcon x:Name="UpdateNavigationIcon" Symbol="Alert24" FontSize="20" />
                                <Ellipse x:Name="UpdateNavigationBadge" Width="7" Height="7"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-2,0"
                                         Fill="#E03131" Stroke="{StaticResource Brush.Canvas}" StrokeThickness="1.5"
                                         Visibility="Collapsed" />
                                <ui:ProgressRing x:Name="UpdateNavigationLoading" Width="14" Height="14"
                                                 IsIndeterminate="True" Visibility="Collapsed"
                                                 Foreground="{StaticResource Brush.Primary}" />
                            </Grid>
                            <TextBlock Text="更新" Style="{StaticResource Rail.Label}" />
                        </StackPanel>
                    </views:RailItem>
                    <Border />
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid Background="{StaticResource Brush.Canvas}">
                    <!-- Settings owns its definition-driven view and namescope. -->
                    <Grid x:Name="HomeView">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320" />
                            <ColumnDefinition x:Name="RuntimeSidebarColumn" Width="392" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                    <Grid x:Name="TasksView" Margin="16,12,16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- One header row: the tab bar shrinks and scrolls while the title and lock badge keep their
                             size, so locking, unlocking and adding tabs never shift the workspace. -->
                        <Grid Grid.Row="0" Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="任务" VerticalAlignment="Center"
                                       Style="{StaticResource WindowTitleTextStyle}" />
                            <Border x:Name="ConfigurationBar" Grid.Column="1" Margin="16,0" HorizontalAlignment="Left"
                                    Style="{StaticResource Configuration.Bar}"
                                    Visibility="{Binding Visibility, ElementName=TaskWorkspacePanel}">
                                <DockPanel PreviewMouseDown="ConfigurationActions_PreviewMouseDown"
                                           PreviewKeyDown="ConfigurationActions_PreviewKeyDown">
                                    <Button x:Name="NewConfigurationButton" DockPanel.Dock="Right"
                                            Style="{StaticResource Configuration.Add}"
                                            ToolTip="新建空配置" AutomationProperties.Name="新建空配置"
                                            Click="NewConfigurationButton_Click">
                                        <ui:SymbolIcon Symbol="Add16" FontSize="15" />
                                    </Button>
                                    <TabControl x:Name="ConfigurationTabs" BorderThickness="0" Padding="0"
                                                Background="Transparent"
                                                SelectionChanged="ConfigurationTabs_SelectionChanged"
                                                PreviewKeyDown="ConfigurationTabs_PreviewKeyDown"
                                                IsVisibleChanged="ConfigurationTabs_IsVisibleChanged"
                                                AutomationProperties.Name="任务配置">
                                        <TabControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </TabControl.ItemsPanel>
                                        <TabControl.Template>
                                            <ControlTemplate TargetType="TabControl">
                                                <ScrollViewer x:Name="ConfigurationScroll"
                                                              Template="{StaticResource Configuration.Scroll}"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Disabled"
                                                    PreviewMouseWheel="ConfigurationScroll_PreviewMouseWheel"
                                                              CanContentScroll="False" Focusable="False">
                                                    <ItemsPresenter KeyboardNavigation.TabNavigation="Once" />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </TabControl.Template>
                                    </TabControl>
                                </DockPanel>
                            </Border>
                            <Border x:Name="ConfigurationLockBadge" Grid.Column="2" Padding="8,3,10,3"
                                    VerticalAlignment="Center" CornerRadius="11" Visibility="Collapsed"
                                    Background="{StaticResource Brush.Surface.Disabled}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="LockClosed16" FontSize="14" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                                    <TextBlock x:Name="ConfigurationLockText" VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="ProjectValidationBorder"
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                Padding="12,8"
                                Background="{StaticResource Brush.Error.Surface}"
                                BorderBrush="{StaticResource Brush.Error.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ProjectValidationText"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Error.Foreground}"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       AutomationProperties.Name="任务配置校验结果"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Border>

                        <Border x:Name="ProjectEmptyStatePanel"
                                Grid.Row="2"
                                Margin="0,16,0,0"
                                Style="{StaticResource SettingsSectionPanelStyle}">
                            <StackPanel MaxWidth="460"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="ProjectEmptyStateTitleText"
                                           HorizontalAlignment="Center"
                                           Text="MaaNOP 项目无法加载"
                                           TextAlignment="Center"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="ProjectEmptyStateDetailText"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"
                                           Text="请使用完整的 MaaNOP 发布包，确保安装目录下直接包含 interface.json。"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="TaskWorkspacePanel"
                              Grid.Row="2"
                              Margin="0,12,0,0"
                              SizeChanged="TaskWorkspacePanel_SizeChanged"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="142" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Height="34" Margin="0,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="执行计划" FontSize="15"
                                               Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock x:Name="PlanCountText" Margin="8,0,0,0" FontSize="13"
                                               VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <!-- Opens the inline panel that stays open while several tasks are added. -->
                                <Button x:Name="TaskShelfHeaderButton" Grid.Column="2" Height="32" Padding="12,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="TaskShelfHeaderButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon x:Name="TaskShelfHeaderIcon" Symbol="Add16" FontSize="15"
                                                       Margin="0,0,6,0" />
                                        <TextBlock x:Name="TaskShelfHeaderText" Text="添加任务" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground,
                                                       RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border x:Name="TaskShelfContent" Visibility="Collapsed"
                                    Grid.Row="1" MaxHeight="340" Margin="0,10,8,0"
                                    Style="{StaticResource TaskShelfSurfaceStyle}" AutomationProperties.Name="添加任务">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="12,8,8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="可用任务" VerticalAlignment="Center"
                                                       Style="{StaticResource SectionTitleTextStyle}" />
                                            <TextBlock x:Name="AvailableTaskCountText" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource MutedTextStyle}" />
                                            <StackPanel x:Name="AddedTasksBadge" Orientation="Horizontal"
                                                        Margin="12,0,0,0" Background="Transparent"
                                                        Visibility="Collapsed">
                                                <ui:SymbolIcon Symbol="Checkmark16" FontSize="13" Margin="0,0,4,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Brush.TasksAccent}" />
                                                <TextBlock x:Name="AddedTasksText" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.TasksAccent}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ui:TextBox x:Name="TaskSearchBox" Grid.Column="2" Width="180" MinHeight="32"
                                                    PlaceholderText="搜索任务"
                                                    AutomationProperties.Name="搜索可用任务"
                                                    TextChanged="TaskSearchBox_TextChanged" />
                                    </Grid>
                                    <ScrollViewer x:Name="AvailableTasksScroll" Grid.Row="1" Margin="12,0,0,8"
                                                  Template="{StaticResource Scroll.Faded}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False">
                                        <StackPanel x:Name="AvailableTasksPanel" Margin="0,0,8,0" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <ScrollViewer x:Name="PlanScroll" Grid.Row="2" Margin="0,10,0,0" MinHeight="132"
                                          Template="{StaticResource Scroll.Faded}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                <StackPanel Margin="0,0,8,24">
                                    <StackPanel x:Name="PlanItemsPanel"
                                                AllowDrop="True"
                                                DragLeave="PlanItemsPanel_DragLeave"
                                                DragOver="PlanItemsPanel_DragOver"
                                                Drop="PlanItemsPanel_Drop" />

                                    <StackPanel x:Name="EmptyPlanPanel" Margin="0,16,0,0">
                                        <TextBlock Text="执行计划为空" FontWeight="SemiBold" />
                                        <TextBlock x:Name="EmptyPlanText" Margin="0,4,0,0"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                        <Button x:Name="EmptyPlanAddButton" Margin="0,12,0,0" Height="32"
                                                Padding="12,0" HorizontalAlignment="Left"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="TaskShelfHeaderButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Add16" FontSize="15" Margin="0,0,6,0" />
                                                <TextBlock Text="添加任务" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground,
                                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                        </Grid>
                        <!-- One runtime console: run control, game preview and grouped activity as sections. -->
                        <Border x:Name="RuntimeSidebar" Grid.Column="1" Margin="0,14,16,16"
                                Style="{StaticResource Console.Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="120" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="RuntimeControlCard" Margin="16,12,16,16">
                                    <Grid Height="28" Margin="0,0,-8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="运行控制" Style="{StaticResource Console.SectionTitle}" />
                                        <Border x:Name="RuntimeStatusPill" Grid.Column="1" Margin="8,0,0,0"
                                                Style="{StaticResource Console.Pill}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                         Fill="{Binding Foreground, ElementName=RuntimeStatusText}" />
                                                <TextBlock x:Name="RuntimeStatusText" Margin="6,0,0,0" FontSize="12"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="RuntimeMoreButton" Grid.Column="3"
                                                Style="{StaticResource Preview.IconButton}"
                                                ToolTip="更多操作" AutomationProperties.Name="更多操作"
                                                Click="RuntimeMoreButton_Click">
                                            <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="18" />
                                            <Button.ContextMenu>
                                                <ContextMenu x:Name="RuntimeMoreMenu">
                                                    <MenuItem x:Name="DesktopMenuItem" Header="显示桌面分身"
                                                              Click="HomeDesktopVisibilityButton_Click">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon x:Name="DesktopMenuIcon" Symbol="Eye16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem x:Name="ExpandPreviewMenuItem" Header="放大游戏画面"
                                                              Click="ExpandPreview_Click">
                                                        <MenuItem.Icon>
                                                            <Path Style="{StaticResource Preview.ExpandIcon}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem x:Name="OpenLogsMenuItem" Header="打开日志目录"
                                                              Click="OpenLogsMenuItem_Click">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Symbol="Folder16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem x:Name="EndEnvironmentMenuItem" Header="结束桌面分身"
                                                              Foreground="{StaticResource Brush.Error.Foreground}"
                                                              Click="EndEnvironmentMenuItem_Click">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Symbol="SignOut20" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="RuntimeStatusTitle" Margin="0,12,0,0" FontSize="15"
                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.Text.Primary}" />
                                    <TextBlock x:Name="RuntimeStatusDetail" Margin="0,2,0,0" FontSize="12.5"
                                               TextWrapping="Wrap" LineHeight="19"
                                               Foreground="{StaticResource Brush.Text.Secondary}" />
                                    <StackPanel x:Name="RunProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                        <Canvas x:Name="RunProgressBar" Height="6" ClipToBounds="True"
                                                SizeChanged="RunProgressBar_SizeChanged" />
                                        <Grid Margin="0,6,0,0">
                                            <TextBlock x:Name="RunProgressCaption" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource Brush.Text.Muted}" />
                                            <TextBlock x:Name="RunProgressElapsed" FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource Brush.Text.Muted}" />
                                        </Grid>
                                    </StackPanel>
                                    <!-- Exactly one primary action shows; RuntimeControls decides which. -->
                                    <Grid Margin="0,14,0,0">
                                        <Button x:Name="PrepareEnvironmentButton"
                                                Style="{StaticResource Console.PrimaryButton}"
                                                ToolTip="准备运行环境" AutomationProperties.Name="准备运行环境"
                                                Click="PrepareEnvironmentButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Power20" FontSize="16" Margin="0,0,8,0" />
                                                <TextBlock Text="准备运行环境" Style="{StaticResource Console.ButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RetryEnvironmentButton" Visibility="Collapsed"
                                                Style="{StaticResource Console.PrimaryButton}"
                                                ToolTip="重试" ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="重试运行环境"
                                                Click="RetryRuntimeHeaderButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowClockwise20" FontSize="16"
                                                               Margin="0,0,8,0" />
                                                <TextBlock Text="重试" Style="{StaticResource Console.ButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="StartTaskHeaderButton" Visibility="Collapsed"
                                                Style="{StaticResource Console.PrimaryButton}"
                                                ToolTip="开始任务" ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="开始任务"
                                                Click="StartRunButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Play20" FontSize="16" Margin="0,0,8,0" />
                                                <TextBlock Text="开始任务" Style="{StaticResource Console.ButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="StopTaskHeaderButton" Visibility="Collapsed"
                                                Style="{StaticResource Console.NeutralButton}"
                                                ToolTip="停止任务" AutomationProperties.Name="停止任务"
                                                Click="StopRunButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Stop20" FontSize="16" Margin="0,0,8,0" />
                                                <TextBlock Text="停止任务" Style="{StaticResource Console.ButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RecoverEnvironmentButton" Visibility="Collapsed"
                                                Style="{StaticResource Console.DangerButton}"
                                                ToolTip="结束桌面分身" ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="结束桌面分身"
                                                Click="RecoverEnvironmentButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="SignOut20" FontSize="16" Margin="0,0,8,0" />
                                                <TextBlock Text="结束桌面分身"
                                                           Style="{StaticResource Console.ButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <Border x:Name="RuntimeHeaderProgressRing" Height="36" CornerRadius="6"
                                                Visibility="Collapsed"
                                                Background="{StaticResource Brush.Surface.Disabled}"
                                                ToolTip="正在准备运行环境" AutomationProperties.Name="正在准备运行环境">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock x:Name="RuntimeProgressText" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.Text.Secondary}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <Border x:Name="PreviewCard" Grid.Row="1" Style="{StaticResource Console.Section}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Console.SectionHeader}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="游戏画面" Style="{StaticResource Console.SectionTitle}" />
                                            <StackPanel x:Name="PreviewLiveIndicator" Grid.Column="1" Margin="10,0,0,0"
                                                        Orientation="Horizontal" Visibility="Collapsed">
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                         Fill="{StaticResource Brush.Success}" />
                                                <TextBlock x:Name="PreviewLiveText" Margin="6,0,0,0" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.Text.Muted}" />
                                            </StackPanel>
                                            <Button x:Name="ExpandPreviewButton" Grid.Column="2"
                                                    Style="{StaticResource Preview.IconButton}"
                                                    ToolTip="放大游戏画面" AutomationProperties.Name="放大游戏画面"
                                                    Click="ExpandPreview_Click">
                                                <Path Style="{StaticResource Preview.ExpandIcon}" />
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource Preview.IconButton}"
                                                    ToolTip="展开或收起游戏画面" AutomationProperties.Name="展开或收起游戏画面"
                                                    Click="TogglePreview_Click">
                                                <ui:SymbolIcon x:Name="PreviewChevron" Symbol="ChevronUp16"
                                                               FontSize="16" />
                                            </Button>
                                        </Grid>
                                        <Grid x:Name="PreviewCardContent" Margin="12,0,12,12">
                                            <!-- Kept at 16:9 from its width, so empty-state text keeps its size. -->
                                            <Border x:Name="PreviewScreen" CornerRadius="6" ClipToBounds="True"
                                                    Background="{StaticResource Preview.Surface}"
                                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                    BorderThickness="1"
                                                    SizeChanged="PreviewScreen_SizeChanged">
                                                <Grid>
                                                    <Image x:Name="HomePreviewImage" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="Collapsed" />
                                                    <ContentControl x:Name="HomePreviewPlaceholder"
                                                                    ContentTemplate="{StaticResource Preview.Empty}"
                                                                    Tag="暂无画面"
                                                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                                                </Grid>
                                            </Border>
                                            <!-- Desktop and enlarge shortcuts float over a live picture on hover. -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom" Margin="0,0,8,8"
                                                        Style="{StaticResource Preview.Overlay}">
                                                <Button x:Name="HomeDesktopVisibilityButton" IsEnabled="False"
                                                        Style="{StaticResource Preview.OverlayButton}"
                                                        AutomationProperties.Name="显示分身" ToolTip="显示分身"
                                                        Click="HomeDesktopVisibilityButton_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                                            <Path Width="24" Height="24" StrokeThickness="2"
                                                                  Stroke="{Binding Foreground,
                                                                   RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round">
                                                                <Path.Style>
                                                                    <Style TargetType="{x:Type Path}">
                                                                        <Setter Property="Data"
                                                                             Value="M9,19 L4,19 Q2,19 2,17 L2,4 Q2,2 4,2
                                                                                       L19,2 Q21,2 21,4 L21,9
                                                                                       M9,16 Q16,7 23,16 Q16,25 9,16 Z
                                                                                       M18,16 A2,2 0 1 1 14,16
                                                                                       A2,2 0 1 1 18,16" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Value="True"
                                                                                Binding="{Binding Tag,
                                                                                    RelativeSource={RelativeSource
                                                                                        AncestorType=Button}}">
                                                                                <Setter Property="Data"
                                                                                    Value="M3,3 L21,21 M9,5 Q17,2 23,12
                                                                                          Q21,16 19,17 M15,19 Q7,22 1,12
                                                                                      Q3,8 5,7 M9,9 A4,4 0 0 0 15,15" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Viewbox>
                                                        <AccessText x:Name="HomeDesktopVisibilityText" Text="显示分身"
                                                                    VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="6,0,0,0" Style="{StaticResource Preview.OverlayButton}"
                                                        ToolTip="放大游戏画面" AutomationProperties.Name="放大游戏画面"
                                                        Click="ExpandPreview_Click">
                                                    <Path Style="{StaticResource Preview.ExpandIcon}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.RowSpan="2" Style="{StaticResource Console.Section}" />
                                    <Grid Style="{StaticResource Console.SectionHeader}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="运行动态" Style="{StaticResource Console.SectionTitle}" />
                                            <TextBlock x:Name="RunLogCountText" Margin="8,0,0,0" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.Text.Muted}" />
                                        </StackPanel>
                                        <Button x:Name="ClearActivityButton" Grid.Column="1" ToolTip="清空面板中的运行动态"
                                                Style="{StaticResource Activity.ClearButton}"
                                                Click="ClearActivity_Click"
                                                IsEnabled="{Binding HasItems, ElementName=HomeLogListBox}"
                                                AutomationProperties.Name="清空运行动态">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="14" Stretch="Uniform" Margin="0,0,5,0"
                                                      Stroke="{Binding Foreground,
                                                          RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                                      Data="M3,6 L21,6 M9,6 L9,3 L15,3 L15,6
                                                            M5,6 L6,22 L18,22 L19,6 M10,10 L10,18 M14,10 L14,18" />
                                                <TextBlock Text="清空" FontSize="11"
                                                           Foreground="{Binding Foreground,
                                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="8,0,8,8">
                                        <ListBox x:Name="HomeLogListBox" ItemsSource="{Binding LogLines}"
                                                 Style="{StaticResource LogListBoxStyle}"
                                                 Background="{StaticResource Brush.Surface}"
                                                 BorderThickness="0" Padding="0"
                                                 FontFamily="{StaticResource FontFamily.Ui}"
                                                 VirtualizingPanel.ScrollUnit="Item"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="运行动态"
                                                 AutomationProperties.HelpText="最新在顶部，按任务分组，仅显示 MaaNOP 用户运行日志">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}"
                                                       BasedOn="{StaticResource LogListBoxItemStyle}">
                                                    <!-- A group heading always sits on top, so the newest
                                                         entry is the second row. -->
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding
                                                                    Converter="{StaticResource Activity.IsLatest}">
                                                                    <Binding />
                                                                    <Binding Path="ItemsSource[1]"
                                                                             RelativeSource="{RelativeSource
                                                                        AncestorType=ListBox}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource Brush.Primary.Surface}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.Resources>
                                                <DataTemplate DataType="{x:Type models:RunLogGroup}">
                                                    <Grid Margin="6,8,6,2" Focusable="False">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                                   FontWeight="SemiBold" MaxWidth="240"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource Brush.Text.Muted}" />
                                                        <Border Grid.Column="1" Height="1" Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Background="{StaticResource Brush.Border.Subtle}" />
                                                    </Grid>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type models:LogEntry}">
                                                    <Border MinHeight="28" Padding="6,5"
                                                            BorderBrush="#EDF2F8" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="12" Foreground="#667FA5" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                                       Foreground="{StaticResource Brush.Text.Primary}"
                                                                       FontSize="12" TextWrapping="Wrap"
                                                                       AutomationProperties.HelpText="{Binding
                                                                           DisplayLevel}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.Resources>
                                        </ListBox>
                                        <Grid IsHitTestVisible="False">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems,
                                                            ElementName=HomeLogListBox}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                                                <StackPanel Width="300" HorizontalAlignment="Center">
                                                    <Grid Width="72" Height="64" Margin="0,0,0,8">
                                                        <Ellipse Width="64" Height="64" Fill="#F1F6FD" />
                                                        <Border Width="34" Height="34" CornerRadius="4"
                                                                Background="#C4D6EE" VerticalAlignment="Center">
                                                            <Path Margin="7" Stroke="White" StrokeThickness="3"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Data="M0,3 L20,3 M0,10 L20,10 M0,17 L12,17" />
                                                        </Border>
                                                        <Ellipse Width="4" Height="4" Fill="#CBDDF5"
                                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                 Margin="0,15,0,0" />
                                                        <Path Fill="#CBDDF5" HorizontalAlignment="Right"
                                                              VerticalAlignment="Top" Data="M4,0 L5,3 L8,4 L5,5
                                                                                              L4,8 L3,5 L0,4 L3,3 Z" />
                                                    </Grid>
                                                    <TextBlock Text="暂无运行动态" TextAlignment="Center"
                                                               Style="{StaticResource SectionTitleTextStyle}" />
                                                    <TextBlock Text="任务开始后，将在此处显示关键状态更新"
                                                               TextAlignment="Center" Margin="0,6,0,0" FontSize="11"
                                                               Foreground="#667FA5" />
                                                </StackPanel>
                                            </Viewbox>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <views:SettingsView x:Name="SettingsView" Visibility="Collapsed" />

                    <Grid x:Name="TaskDescriptionOverlay"
                          Panel.ZIndex="100"
                          Visibility="Collapsed"
                          AutomationProperties.Name="任务描述">
                        <Button Background="{StaticResource Brush.Overlay.Dim}"
                                BorderThickness="0"
                                Focusable="False"
                                Click="TaskDescriptionScrim_Click" />
                        <Border Width="420"
                                MaxWidth="420"
                                HorizontalAlignment="Right"
                                Style="{StaticResource TaskDescriptionDrawerStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TaskDescriptionDrawerTitle"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource StatusPrimaryTextStyle}" />
                                    <Button x:Name="TaskDescriptionCloseButton"
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Style="{StaticResource CompactIconButtonStyle}"
                                            AutomationProperties.Name="关闭任务描述"
                                            Click="TaskDescriptionCloseButton_Click">
                                        <ui:SymbolIcon Width="16" Height="16" Symbol="Dismiss16" />
                                    </Button>
                                </Grid>
                                <Border Grid.Row="1"
                                        Height="1"
                                        Margin="0,14,0,14"
                                        Background="{StaticResource Brush.Border}" />
                                <FlowDocumentScrollViewer x:Name="TaskDescriptionViewer" Grid.Row="2"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto"
                                                          IsToolBarVisible="False" Zoom="100" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
        <Grid x:Name="PreviewOverlay" Panel.ZIndex="200" Visibility="Collapsed"
              Focusable="True" KeyboardNavigation.TabNavigation="Cycle" SizeChanged="PreviewOverlay_SizeChanged"
              KeyboardNavigation.ControlTabNavigation="Cycle" AutomationProperties.Name="放大实时截图">
            <Button x:Name="PreviewScrim" Background="#300F172A" BorderThickness="0"
                    Focusable="False" IsTabStop="False" Click="ClosePreview_Click"
                    AutomationProperties.Name="关闭放大截图遮罩">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border x:Name="ExpandedPreviewCard" Margin="40" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="{StaticResource Brush.Canvas}"
                    BorderBrush="{StaticResource Preview.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Section}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.2" Color="#0F172A" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Brush.Surface}" Padding="16,0"
                            BorderBrush="{StaticResource Preview.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button x:Name="ClosePreviewButton" DockPanel.Dock="Right"
                                    Style="{StaticResource Preview.IconButton}"
                                    ToolTip="关闭（Esc）" AutomationProperties.Name="关闭放大截图"
                                    Click="ClosePreview_Click">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16"
                                               Foreground="{StaticResource Brush.Text.Secondary}" />
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Preview.Monitor}" Width="16" Height="16"
                                      Stretch="Uniform" Stroke="{StaticResource Brush.Primary}"
                                      StrokeThickness="1.8" Margin="0,0,8,0" />
                                <TextBlock Text="实时截图" Foreground="{StaticResource Brush.Text.Primary}"
                                           FontWeight="SemiBold" />
                                <Border Background="#00854A" Padding="6,2" Margin="12,0,0,0" CornerRadius="3"
                                        Visibility="{Binding Visibility, ElementName=HomePreviewImage}">
                                    <TextBlock Text="● LIVE" Foreground="White" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="8">
                        <Image Source="{Binding Source, ElementName=HomePreviewImage}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <ContentControl ContentTemplate="{StaticResource Preview.Empty}"
                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                        Visibility="{Binding Visibility, ElementName=HomePreviewPlaceholder}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="UpdateOverlay" Panel.ZIndex="210" Visibility="Collapsed" Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              SizeChanged="UpdateOverlay_SizeChanged"
              AutomationProperties.Name="软件更新">
            <Button Background="#59111927" BorderThickness="0" Focusable="False" IsTabStop="False"
                    Click="CloseUpdate_Click" AutomationProperties.Name="关闭软件更新遮罩">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border x:Name="UpdateDialog" Width="440" MaxHeight="600" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Preview.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Section}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.2" Color="#0F172A" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,-8,-8,16">
                        <Button x:Name="CloseUpdateButton" DockPanel.Dock="Right"
                                Style="{StaticResource Preview.IconButton}" Click="CloseUpdate_Click"
                                ToolTip="关闭（Esc）" AutomationProperties.Name="关闭软件更新">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                        </Button>
                        <TextBlock Text="软件更新" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer x:Name="UpdateBodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel x:Name="UpdateCheckingPanel" Margin="0,20,0,24" Visibility="Collapsed">
                                <ui:ProgressRing Width="44" Height="44" IsIndeterminate="True"
                                                 CoverRingVisibility="Visible"
                                                 CoverRingStroke="{StaticResource Preview.Border}"
                                                 Foreground="{StaticResource Brush.Primary}" />
                                <TextBlock Text="正在检查更新…" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,24,0,8" />
                                <TextBlock Text="请稍候…" HorizontalAlignment="Center"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="UpdateResultPanel">
                                <Grid Margin="0,8,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="UpdateAppIcon" Source="pack://application:,,,/Assets/app.png"
                                           Width="44" Height="44" />
                                    <Border x:Name="UpdateStateIconBackground" Width="44" Height="44"
                                            CornerRadius="22" Background="{StaticResource Brush.Success}">
                                        <ui:SymbolIcon x:Name="UpdateStateIcon" Symbol="Checkmark24"
                                                       Foreground="White" FontSize="24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="UpdateStateTitle" FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="UpdateVersionText" FontSize="25" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource AncestorType=StackPanel}}" />
                                            <Border x:Name="UpdateVersionBadge" CornerRadius="4" Padding="7,3"
                                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Background="{StaticResource Brush.Primary.Surface}"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="发现新版本" FontSize="11"
                                                           Foreground="{StaticResource Brush.Primary}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock x:Name="UpdateInstalledVersionText" Margin="0,4,0,0"
                                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="UpdateResultMessage" TextWrapping="Wrap" Margin="0,0,0,16"
                                           Style="{StaticResource SecondaryTextStyle}" />
                                <Border x:Name="UpdateNotesPanel" Background="{StaticResource Brush.Surface.Option}"
                                        Padding="16,14,10,14" CornerRadius="{StaticResource Radius.Control}">
                                    <StackPanel>
                                        <TextBlock Text="更新内容" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <FlowDocumentScrollViewer x:Name="UpdateNotesViewer" MaxHeight="260"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  IsToolBarVisible="False" Zoom="100" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock x:Name="UpdateDownloadStatus" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Height="4"
                                     Visibility="Collapsed" Margin="0,0,0,12" />
                        <Button x:Name="DialogCheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click"
                                Style="{StaticResource Update.SecondaryButton}" Height="36" />
                        <Grid x:Name="UpdateAvailableActions">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ReleaseNotesButton" Content="查看更新说明" Click="ReleaseNotes_Click"
                                    Style="{StaticResource Update.SecondaryButton}" Height="36" Padding="8,0" />
                            <Button x:Name="LaterUpdateButton" Content="稍后" Click="CloseUpdate_Click"
                                    Visibility="Collapsed" Style="{StaticResource Update.SecondaryButton}"
                                    Height="36" Padding="8,0" />
                            <Button x:Name="CancelDownloadButton" Content="取消下载" Visibility="Collapsed"
                                    Click="CancelDownload_Click" Style="{StaticResource Update.SecondaryButton}"
                                    Height="36" Padding="8,0" />
                            <Button x:Name="DownloadUpdateButton" Grid.Column="2" Content="立即更新"
                                    Click="DownloadUpdate_Click" Style="{StaticResource Update.PrimaryButton}"
                                    Height="36" Padding="8,0" />
                            <Button x:Name="InstallUpdateButton" Grid.Column="2" Content="安装并重启"
                                    Visibility="Collapsed" Click="InstallUpdate_Click"
                                    Style="{StaticResource Update.PrimaryButton}" Height="36" Padding="8,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="OnboardingOverlay" Panel.ZIndex="220" Visibility="Collapsed" Background="Transparent"
              Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle" AllowDrop="True"
              PreviewDrop="Onboarding_BlockDrop" PreviewDragOver="Onboarding_BlockDrop"
              AutomationProperties.Name="新手指引">
            <Grid.Resources>
                <DataTemplate x:Key="Onboarding.ActionText">
                    <TextBlock Text="{Binding}"
                               FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                               FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </DataTemplate>
            </Grid.Resources>
            <Path x:Name="OnboardingDim" Fill="#42000000" IsHitTestVisible="False" />
            <Path x:Name="OnboardingOutline" Stroke="{StaticResource Brush.Primary.Border}" StrokeThickness="1"
                  IsHitTestVisible="False" />
            <Canvas IsHitTestVisible="False">
                <Border x:Name="OnboardingPulse" Visibility="Collapsed" CornerRadius="12" Width="24" Height="24"
                        BorderBrush="{StaticResource Brush.Primary}" BorderThickness="1.25"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                </Border>
                <Path x:Name="OnboardingArrow" Fill="{StaticResource Brush.Surface}" />
            </Canvas>
            <Border x:Name="OnboardingPopover" Width="312" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Padding="18" Background="{StaticResource Brush.Surface}"
                    CornerRadius="{StaticResource Radius.Section}" Effect="{StaticResource Effect.Surface.Light}"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                        <TextBlock x:Name="OnboardingCounter" DockPanel.Dock="Right" Margin="10,2,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="OnboardingTitle" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <TextBlock x:Name="OnboardingDescription" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OnboardingSkip" Content="跳过" HorizontalAlignment="Left"
                                ContentTemplate="{StaticResource Onboarding.ActionText}"
                                Padding="12,0" Height="34" FontSize="13" FontWeight="Normal"
                                Foreground="{StaticResource Brush.Text.Secondary}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OnboardingSkip_Click" AutomationProperties.Name="跳过新手指引" />
                        <Button x:Name="OnboardingPrevious" Grid.Column="1" Content="上一步" Margin="4,0,8,0"
                                ContentTemplate="{StaticResource Onboarding.ActionText}"
                                Padding="14,0" Height="34" FontSize="13" FontWeight="Normal"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OnboardingPrevious_Click" AutomationProperties.Name="上一步" />
                        <Button x:Name="OnboardingNext" Grid.Column="2" Content="下一步" Padding="14,0"
                                Width="88" Height="34" FontSize="13" FontWeight="SemiBold"
                                ContentTemplate="{StaticResource Onboarding.ActionText}"
                                Style="{StaticResource PrimaryButtonStyle}" Click="OnboardingNext_Click"
                                AutomationProperties.Name="下一步" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
