<ui:FluentWindow x:Class="NarutoAutoGUI.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="NarutoAutoGUI"
                 Width="1180"
                 Height="760"
                 MinWidth="920"
                 MinHeight="640"
                 Background="{StaticResource Brush.Canvas}"
                 Foreground="{StaticResource Brush.Text.Body}"
                 FontFamily="{StaticResource FontFamily.Ui}"
                 FontSize="{StaticResource FontSize.Body}"
                 ExtendsContentIntoTitleBar="True"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="NarutoAutoGUI"
                     Background="{StaticResource Brush.Canvas}" />

        <ui:NavigationView x:Name="RootNavigationView"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="168"
                           IsPaneOpen="True"
                           IsPaneVisible="True"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed"
                           IsTopSeparatorVisible="False"
                           HeaderVisibility="Collapsed"
                           FrameMargin="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="HomeNavigationItem"
                                       Content="首页"
                                       Icon="{ui:SymbolIcon Home24}"
                                       IsActive="True"
                                       Tag="Home"
                                       Click="NavigationItem_Click" />
                <ui:NavigationViewItem x:Name="TasksNavigationItem"
                                       Content="任务"
                                       Icon="{ui:SymbolIcon ClipboardTask24}"
                                       Tag="Tasks"
                                       Click="NavigationItem_Click" />
                <ui:NavigationViewItem x:Name="DesktopSessionNavigationItem"
                                       Content="桌面分身"
                                       Icon="{ui:SymbolIcon Desktop24}"
                                       Tag="DesktopSession"
                                       Click="NavigationItem_Click" />
                <ui:NavigationViewItem x:Name="LogsNavigationItem"
                                       Content="日志"
                                       Icon="{ui:SymbolIcon DocumentBulletList24}"
                                       Tag="Logs"
                                       Click="NavigationItem_Click" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="SettingsNavigationItem"
                                       Content="设置"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       Tag="Settings"
                                       Click="NavigationItem_Click" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid Background="{StaticResource Brush.Canvas}">
                    <!-- All five views intentionally remain in this single XAML namescope. -->
                    <ScrollViewer x:Name="HomeView"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="自动化控制台"
                                           Style="{StaticResource WindowTitleTextStyle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="准备环境、完成游戏登录，然后从主桌面开始任务"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="0,20,0,0"
                                    Style="{StaticResource StatusPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="当前任务"
                                               Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock Grid.Row="1"
                                               Margin="0,6,0,0"
                                               Text="{Binding SelectedItem.Label, ElementName=MaaNopTaskComboBox, TargetNullValue=尚未选择任务, FallbackValue=尚未选择任务}"
                                               Style="{StaticResource StatusPrimaryTextStyle}" />
                                    <TextBlock Grid.Row="2"
                                               Margin="0,4,0,0"
                                               Text="{Binding Text, ElementName=OptionSummaryText}"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                                        <WrapPanel>
                                            <Button x:Name="PrepareEnvironmentButton"
                                                    Margin="0,0,8,8"
                                                    Content="准备运行环境(_O)"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="PrepareEnvironmentButton_Click" />
                                            <Button x:Name="StartRunButton"
                                                    Margin="0,0,8,8"
                                                    Content="开始任务(_U)"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Visibility="Collapsed"
                                                    Click="StartRunButton_Click" />
                                            <Button x:Name="StopRunButton"
                                                    Margin="0,0,8,8"
                                                    Content="停止任务(_X)"
                                                    Style="{StaticResource DestructiveButtonStyle}"
                                                    Visibility="Collapsed"
                                                    Click="StopRunButton_Click" />
                                            <Button x:Name="LaunchGameButton"
                                                    Margin="0,0,8,8"
                                                    Content="仅启动游戏(_G)"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="LaunchGameButton_Click" />
                                        </WrapPanel>
                                        <TextBlock x:Name="HomeNextStepText"
                                                   Margin="0,4,0,0"
                                                   Text="请先准备运行环境。"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="桌面分身"
                                               Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding Text, ElementName=SessionStatusText}"
                                               Style="{StaticResource StatusPrimaryTextStyle}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding Text, ElementName=SessionIdText}"
                                               Style="{StaticResource MonospaceMetaTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Worker"
                                               Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock x:Name="HomeWorkerSummaryText"
                                               Margin="0,6,0,0"
                                               Text="尚未启动"
                                               Style="{StaticResource StatusPrimaryTextStyle}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="详细信息可在任务页的运行环境诊断中查看"
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="运行状态"
                                               Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock x:Name="HomeRunSummaryText"
                                               Margin="0,6,0,0"
                                               Text="尚未运行"
                                               Style="{StaticResource StatusPrimaryTextStyle}"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <Button Margin="0,4,0,0"
                                            HorizontalAlignment="Left"
                                            Content="查看日志"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Click="ViewLogsButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="TasksView"
                                  Visibility="Collapsed"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="任务"
                                           Style="{StaticResource WindowTitleTextStyle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="选择本次运行的任务并调整 MaaNOP 参数"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MaaNOP 项目"
                                               Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock x:Name="ProjectStatusText"
                                               Margin="0,4,0,0"
                                               Text="MaaNOP 项目未就绪"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="前往设置"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Click="OpenSettingsButton_Click" />
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                                <Label Content="任务(_T)"
                                       Target="{Binding ElementName=MaaNopTaskComboBox}" />
                                <ComboBox x:Name="MaaNopTaskComboBox"
                                          Margin="0,6,0,0"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="MaaNopTaskComboBox_SelectionChanged"
                                          AutomationProperties.HelpText="按项目声明顺序选择一个任务" />
                            </StackPanel>

                            <Border Grid.Row="3"
                                    Margin="0,12,0,0"
                                    Padding="12,8"
                                    Background="{StaticResource Brush.Info.Surface}"
                                    BorderBrush="{StaticResource Brush.Primary.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Control}">
                                <TextBlock x:Name="ProjectValidationText"
                                           Text="选择项目后将校验当前任务配置。"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           AutomationProperties.Name="任务配置校验结果"
                                           AutomationProperties.LiveSetting="Polite" />
                            </Border>

                            <StackPanel Grid.Row="4" Margin="0,24,0,0">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="任务参数"
                                               Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock x:Name="OptionSummaryText"
                                               Margin="16,0,0,0"
                                               HorizontalAlignment="Right"
                                               Text="选择任务后显示参数摘要"
                                               TextAlignment="Right"
                                               Style="{StaticResource MutedTextStyle}" />
                                </DockPanel>
                                <Border Height="1"
                                        Margin="0,10,0,12"
                                        Background="{StaticResource Brush.Border}"
                                        SnapsToDevicePixels="True" />
                                <StackPanel x:Name="OptionEditorPanel" />
                            </StackPanel>

                            <Expander Grid.Row="5"
                                      Margin="0,24,0,24"
                                      Header="运行环境诊断"
                                      IsExpanded="False"
                                      AutomationProperties.Name="运行环境诊断">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock x:Name="WorkerObservationText"
                                               Text="Worker 尚未启动"
                                               Style="{StaticResource StatusPrimaryTextStyle}" />
                                    <TextBlock x:Name="WorkerStateText"
                                               Margin="0,6,0,0"
                                               Text="Worker — · Snapshot stale"
                                               Style="{StaticResource MonospaceMetaTextStyle}" />
                                    <TextBlock x:Name="DependencyStatusText"
                                               Margin="0,6,0,0"
                                               Text="依赖尚未探测"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock x:Name="RunStatusText"
                                               Margin="0,6,0,0"
                                               Text="Run — · Plan Item —"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource MonospaceMetaTextStyle}" />
                                    <TextBlock x:Name="WorkerDetailText"
                                               Margin="0,6,0,0"
                                               Text="Worker 尚未启动"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource MutedTextStyle}" />
                                    <Button x:Name="PrepareWorkerButton"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Left"
                                            Content="准备 Worker(_W)"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="PrepareWorkerButton_Click" />
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="DesktopSessionView"
                                  Visibility="Collapsed"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="桌面分身"
                                           Style="{StaticResource WindowTitleTextStyle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="管理用于运行游戏和自动化任务的独立 Windows Session"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="0,20,0,0"
                                    Style="{StaticResource StatusPanelStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{StaticResource Brush.BrandAccent}"
                                            CornerRadius="2" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="SessionStatusText"
                                                   Text="正在检测桌面分身…"
                                                   Style="{StaticResource StatusPrimaryTextStyle}"
                                                   AutomationProperties.Name="桌面分身状态"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock x:Name="SessionDetailText"
                                                   Margin="0,6,0,0"
                                                   Text="正在检查是否存在可恢复的桌面分身。"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock x:Name="SessionIdText"
                                                   Margin="0,6,0,0"
                                                   Text="Session —  ·  RDP —"
                                                   Style="{StaticResource MonospaceMetaTextStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Border x:Name="SessionStatusBadge"
                                                Style="{StaticResource StatusBadgeStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="SessionStatusIndicator"
                                                         Width="6"
                                                         Height="6"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{StaticResource Brush.Info.Foreground}" />
                                                <TextBlock x:Name="SessionStatusBadgeText"
                                                           Text="检测中"
                                                           Foreground="{StaticResource Brush.Info.Foreground}"
                                                           FontSize="{StaticResource FontSize.Label}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Margin="0,10,0,0"
                                                   HorizontalAlignment="Right"
                                                   Text="1920 × 1080  ·  100%"
                                                   Style="{StaticResource MonospaceMetaTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <WrapPanel Grid.Row="2" Margin="0,12,0,24">
                                <Button x:Name="CreateSessionButton"
                                        Margin="0,0,8,8"
                                        Content="创建 / 恢复(_C)"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="CreateSessionButton_Click"
                                        AutomationProperties.HelpText="创建新的桌面分身，或恢复已有桌面分身的连接" />
                                <Button x:Name="ShowSessionButton"
                                        Margin="0,0,8,8"
                                        Content="显示子桌面(_S)"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="ShowSessionButton_Click"
                                        AutomationProperties.HelpText="显示已连接但当前隐藏的子桌面" />
                                <Button x:Name="HideSessionButton"
                                        Margin="0,0,8,8"
                                        Content="隐藏子桌面(_H)"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="HideSessionButton_Click"
                                        AutomationProperties.HelpText="隐藏子桌面窗口，同时保持连接和其中的程序运行" />
                                <Button x:Name="TerminateSessionButton"
                                        Margin="16,0,0,8"
                                        Content="结束桌面分身(_E)"
                                        Style="{StaticResource DestructiveButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="TerminateSessionButton_Click"
                                        AutomationProperties.HelpText="注销桌面分身并结束其中运行的程序" />
                            </WrapPanel>
                        </Grid>
                    </ScrollViewer>

                    <Grid x:Name="LogsView"
                          Margin="24"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="运行日志"
                                               Style="{StaticResource WindowTitleTextStyle}" />
                                    <TextBlock Margin="10,4,0,0"
                                               Text="INFO+"
                                               Style="{StaticResource MonospaceMetaTextStyle}" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0"
                                           Text="显示最近 1000 条 INFO 及以上日志"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="打开日志目录(_L)"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OpenLogsButton_Click" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <ListBox x:Name="LogListBox"
                                     ItemsSource="{Binding LogLines}"
                                     Style="{StaticResource LogListBoxStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="运行日志"
                                     AutomationProperties.HelpText="显示最近一千条 INFO 及以上级别日志">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="22" Padding="4,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="SeverityMarker"
                                                        Grid.Column="0"
                                                        Background="{StaticResource Brush.Transparent}"
                                                        CornerRadius="1" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"
                                                           Foreground="{StaticResource Brush.Text.Muted}"
                                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                                           FontSize="{StaticResource FontSize.Meta}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="LogLevelText"
                                                           Grid.Column="3"
                                                           Text="{Binding DisplayLevel}"
                                                           Foreground="{StaticResource Brush.Primary}"
                                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                                           FontSize="{StaticResource FontSize.Meta}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Message}"
                                                           Foreground="{StaticResource Brush.Text.Body}"
                                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                                           FontSize="{StaticResource FontSize.Meta}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding DisplayLevel}" Value="WARN">
                                                <Setter TargetName="SeverityMarker" Property="Background" Value="{StaticResource Brush.Warning}" />
                                                <Setter TargetName="LogLevelText" Property="Foreground" Value="{StaticResource Brush.Warning.Foreground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DisplayLevel}" Value="ERROR">
                                                <Setter TargetName="SeverityMarker" Property="Background" Value="{StaticResource Brush.Error}" />
                                                <Setter TargetName="LogLevelText" Property="Foreground" Value="{StaticResource Brush.Error.Foreground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DisplayLevel}" Value="CRITICAL">
                                                <Setter TargetName="SeverityMarker" Property="Background" Value="{StaticResource Brush.Error}" />
                                                <Setter TargetName="LogLevelText" Property="Foreground" Value="{StaticResource Brush.Error.Foreground}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="暂无运行日志"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SecondaryTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=LogListBox}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button x:Name="ResumeLogFollowButton"
                                    Margin="0,0,16,16"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Panel.ZIndex="2"
                                    Content="有新日志，继续跟随(_F)"
                                    Style="{StaticResource NewLogsButtonStyle}"
                                    Visibility="Collapsed"
                                    AutomationProperties.LiveSetting="Polite"
                                    Click="ResumeLogFollowButton_Click" />
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="SettingsView"
                                  Visibility="Collapsed"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24"
                              MaxWidth="820"
                              HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="设置"
                                           Style="{StaticResource WindowTitleTextStyle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="配置游戏入口、MaaNOP 项目和应用行为"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                                <TextBlock Text="游戏启动"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <Label Margin="0,14,0,0"
                                       Content="游戏程序(_P)"
                                       Target="{Binding ElementName=GamePathTextBox}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GamePathTextBox"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                             AutomationProperties.HelpText="游戏 exe 路径"
                                             LostKeyboardFocus="PathsTextBox_LostKeyboardFocus" />
                                    <Button Grid.Column="2"
                                            Content="浏览…(_B)"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Click="BrowseGameButton_Click" />
                                </Grid>

                                <Label Margin="0,14,0,0"
                                       Content="启动参数(_A)"
                                       Target="{Binding ElementName=GameArgumentsTextBox}" />
                                <TextBox x:Name="GameArgumentsTextBox"
                                         Margin="0,6,0,0"
                                         ToolTip="传递给游戏启动程序的命令行参数"
                                         AutomationProperties.HelpText="火影忍者 Online 使用 -/appid:1103286479"
                                         LostKeyboardFocus="PathsTextBox_LostKeyboardFocus" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="火影忍者 Online 默认通过 QQMicroGameBox\Launch.exe 和 appid 参数启动。"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Height="1"
                                    Margin="0,24,0,0"
                                    Background="{StaticResource Brush.Border}"
                                    SnapsToDevicePixels="True" />

                            <StackPanel Grid.Row="3" Margin="0,24,0,0">
                                <TextBlock Text="MaaNOP"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <Label Margin="0,14,0,0"
                                       Content="项目目录(_M)"
                                       Target="{Binding ElementName=MaaNopProjectDirectoryTextBox}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MaaNopProjectDirectoryTextBox"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                             AutomationProperties.HelpText="直接包含 interface.json 的 MaaNOP Project Directory"
                                             LostKeyboardFocus="MaaNopProjectDirectoryTextBox_LostKeyboardFocus" />
                                    <Button x:Name="BrowseMaaNopProjectButton"
                                            Grid.Column="2"
                                            Content="浏览…(_R)"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Click="BrowseMaaNopProjectButton_Click" />
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Text="请选择直接包含 interface.json 的项目目录。"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Margin="0,24,0,24">
                                <Border Height="1"
                                        Margin="0,0,0,24"
                                        Background="{StaticResource Brush.Border}"
                                        SnapsToDevicePixels="True" />
                                <TextBlock Text="应用行为"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Margin="0,10,0,0"
                                           Text="关闭主窗口时会隐藏到系统托盘，任务与桌面分身继续运行。请使用托盘菜单中的“退出程序”完成清理。"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <Border Grid.Row="2"
                Padding="16,0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="OperationStatusText"
                           VerticalAlignment="Center"
                           Text="就绪"
                           Style="{StaticResource SecondaryTextStyle}"
                           AutomationProperties.Name="操作状态"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="OperationProgressBar"
                             Grid.Column="1"
                             Width="120"
                             Height="4"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             IsTabStop="False"
                             AutomationProperties.Name="操作正在进行" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
