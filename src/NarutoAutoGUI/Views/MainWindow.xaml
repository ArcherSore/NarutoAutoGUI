<ui:FluentWindow x:Class="NarutoAutoGUI.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="NarutoAutoGUI"
                 Width="1180"
                 Height="760"
                 MinWidth="920"
                 MinHeight="640"
                 Background="{StaticResource Brush.Canvas}"
                 Foreground="{StaticResource Brush.Text.Body}"
                 FontFamily="{StaticResource FontFamily.Ui}"
                 FontSize="{StaticResource FontSize.Body}"
                 ExtendsContentIntoTitleBar="True"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="NarutoAutoGUI"
                     Background="{StaticResource Brush.Canvas}" />

        <ui:NavigationView x:Name="RootNavigationView"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="168"
                           IsPaneOpen="True"
                           IsPaneVisible="True"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed"
                           IsTopSeparatorVisible="False"
                           HeaderVisibility="Collapsed"
                           FrameMargin="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="HomeNavigationItem"
                                       Content="首页"
                                       Icon="{ui:SymbolIcon Home24}"
                                       IsActive="True"
                                       Tag="Home"
                                       Click="NavigationItem_Click" />
                <ui:NavigationViewItem x:Name="TasksNavigationItem"
                                       Content="任务"
                                       Icon="{ui:SymbolIcon ClipboardTask24}"
                                       Tag="Tasks"
                                       Click="NavigationItem_Click" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="SettingsNavigationItem"
                                       Content="设置"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       Tag="Settings"
                                       Click="NavigationItem_Click" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid Background="{StaticResource Brush.Canvas}">
                    <!-- Home, Tasks and Settings intentionally remain in this single XAML namescope. -->
                    <ScrollViewer x:Name="HomeView"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalContentAlignment="Stretch"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="运行控制台" Style="{StaticResource WindowTitleTextStyle}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="管理当前任务的执行与运行动态"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="打开日志目录(_L)"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Click="OpenLogsButton_Click" />
                            </Grid>

                            <Border Grid.Row="2" Margin="0" Style="{StaticResource StatusPanelStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.8*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="当前任务" Style="{StaticResource SectionTitleTextStyle}" />
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource StatusPrimaryTextStyle}">
                                            <TextBlock.Text>
                                                <Binding Path="SelectedItem.Label"
                                                         ElementName="TaskListBox"
                                                         TargetNullValue="尚未选择任务"
                                                         FallbackValue="尚未选择任务" />
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock x:Name="HomeOptionSummaryText"
                                                   Margin="0,4,0,0"
                                                   Text="选择任务后显示参数摘要"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{StaticResource Brush.Border}" />

                                    <StackPanel Grid.Column="2" Margin="16,0">
                                        <TextBlock Text="当前状态" Style="{StaticResource SectionTitleTextStyle}" />
                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                            <Ellipse x:Name="HomeStatusIndicator"
                                                     Width="8"
                                                     Height="8"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{StaticResource Brush.Text.Muted}" />
                                            <TextBlock x:Name="HomeRunSummaryText"
                                                       Text="尚未就绪"
                                                       Style="{StaticResource StatusPrimaryTextStyle}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                        <TextBlock x:Name="HomeWorkerSummaryText"
                                                   Margin="0,4,0,0"
                                                   Text="Worker 尚未启动"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>

                                    <Border Grid.Column="3" Background="{StaticResource Brush.Border}" />

                                    <StackPanel Grid.Column="4" Margin="16,0">
                                        <TextBlock Text="当前步骤" Style="{StaticResource SectionTitleTextStyle}" />
                                        <TextBlock x:Name="HomeCurrentStepText"
                                                   Margin="0,6,0,0"
                                                   Text="等待下一步"
                                                   Style="{StaticResource StatusPrimaryTextStyle}" />
                                        <TextBlock x:Name="HomeNextStepText"
                                                   Margin="0,4,0,0"
                                                   Text="请先准备运行环境。"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>

                                    <Border Grid.Column="5" Background="{StaticResource Brush.Border}" />

                                    <StackPanel Grid.Column="6" Margin="16,0,0,0">
                                        <TextBlock Text="操作" Style="{StaticResource SectionTitleTextStyle}" />
                                        <Button x:Name="HomePrimaryActionButton"
                                                Margin="0,8,0,0"
                                                Content="准备运行环境(_O)"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="{Binding Text, ElementName=HomeNextStepText}"
                                                Click="HomePrimaryActionButton_Click">
                                            <AutomationProperties.HelpText>
                                                <Binding Path="Text" ElementName="HomeNextStepText" />
                                            </AutomationProperties.HelpText>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="4" Height="352">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Padding="16"
                                        Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Section}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="游戏画面预览" Style="{StaticResource SectionTitleTextStyle}" />
                                        <Viewbox Grid.Row="2" Stretch="Uniform">
                                            <Border Width="640"
                                                    Height="360"
                                                    Background="{StaticResource Brush.Surface.Subdued}"
                                                    BorderBrush="{StaticResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius.Control}">
                                                <Grid>
                                                    <Image x:Name="HomePreviewImage"
                                                           Stretch="Uniform"
                                                           Visibility="Collapsed" />
                                                    <StackPanel x:Name="HomePreviewPlaceholder"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <ui:SymbolIcon FontSize="64"
                                                                       Foreground="{StaticResource Brush.Text.Muted}"
                                                                       Symbol="Desktop48" />
                                                        <TextBlock Margin="0,16,0,0"
                                                                   HorizontalAlignment="Center"
                                                                   FontSize="28"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                                   Text="暂无游戏画面" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Viewbox>
                                        <Grid Grid.Row="4" HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="HomeDesktopVisibilityButton"
                                                    Content="打开完整桌面(_S)"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Visibility="Collapsed"
                                                    Click="HomeDesktopVisibilityButton_Click" />
                                            <Button x:Name="HomeTerminateSessionButton"
                                                    Grid.Column="2"
                                                    Content="结束桌面分身(_E)"
                                                    Style="{StaticResource DestructiveButtonStyle}"
                                                    Visibility="Collapsed"
                                                    Click="TerminateSessionButton_Click"
                                                    AutomationProperties.HelpText="注销桌面分身并结束其中运行的程序" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2"
                                        Padding="16"
                                        Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Section}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="运行动态" Style="{StaticResource SectionTitleTextStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="MaaNOP"
                                                       Style="{StaticResource MonospaceMetaTextStyle}" />
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <ListBox x:Name="HomeLogListBox"
                                                     ItemsSource="{Binding LogLines}"
                                                     Style="{StaticResource LogListBoxStyle}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     AutomationProperties.Name="运行动态"
                                                     AutomationProperties.HelpText="仅显示 MaaNOP 用户运行日志">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border MinHeight="28"
                                                                Padding="4"
                                                                BorderBrush="{StaticResource Brush.Border}"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="72" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="16" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                    Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                                    Style="{StaticResource MonospaceMetaTextStyle}"
                                                                    VerticalAlignment="Center" />
                                                                <ui:SymbolIcon x:Name="ActivityIcon"
                                                                    Grid.Column="2"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Foreground="{StaticResource Brush.Primary}"
                                                                    Symbol="Info16"
                                                                    AutomationProperties.Name="信息" />
                                                                <TextBlock Grid.Column="4"
                                                                           Text="{Binding Message}"
                                                                           Foreground="{StaticResource Brush.Text.Body}"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding DisplayLevel}" Value="DEBUG">
                                                                <Setter TargetName="ActivityIcon"
                                                                        Property="Symbol"
                                                                        Value="BroadActivityFeed16" />
                                                                <Setter TargetName="ActivityIcon"
                                                                        Property="Foreground"
                                                                        Value="{StaticResource Brush.Text.Muted}" />
                                                                <Setter TargetName="ActivityIcon"
                                                                        Property="AutomationProperties.Name"
                                                                        Value="调试" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DisplayLevel}" Value="WARN">
                                                                <Setter TargetName="ActivityIcon"
                                                                        Property="Symbol"
                                                                        Value="Warning16" />
                                                                <Setter TargetName="ActivityIcon"
                                                                    Property="Foreground"
                                                                    Value="{StaticResource Brush.Warning.Foreground}" />
                                                                <Setter TargetName="ActivityIcon"
                                                                        Property="AutomationProperties.Name"
                                                                        Value="警告" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DisplayLevel}" Value="ERROR">
                                                                <Setter TargetName="ActivityIcon"
                                                                        Property="Symbol"
                                                                        Value="ErrorCircle16" />
                                                                <Setter TargetName="ActivityIcon"
                                                                    Property="Foreground"
                                                                    Value="{StaticResource Brush.Error.Foreground}" />
                                                                <Setter TargetName="ActivityIcon"
                                                                        Property="AutomationProperties.Name"
                                                                        Value="错误" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DisplayLevel}"
                                                                Value="CRITICAL">
                                                                <Setter TargetName="ActivityIcon"
                                                                        Property="Symbol"
                                                                        Value="ErrorCircle16" />
                                                                <Setter TargetName="ActivityIcon"
                                                                    Property="Foreground"
                                                                    Value="{StaticResource Brush.Error.Foreground}" />
                                                                <Setter TargetName="ActivityIcon"
                                                                        Property="AutomationProperties.Name"
                                                                        Value="严重错误" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Text="暂无运行动态">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}"
                                                           BasedOn="{StaticResource SecondaryTextStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Value="False">
                                                                <DataTrigger.Binding>
                                                                    <Binding Path="HasItems"
                                                                        ElementName="HomeLogListBox" />
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button x:Name="HomeResumeLogFollowButton"
                                                    Margin="0,0,12,12"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Panel.ZIndex="2"
                                                    Content="有新日志，继续跟随(_F)"
                                                    Style="{StaticResource NewLogsButtonStyle}"
                                                    Visibility="Collapsed"
                                                    AutomationProperties.LiveSetting="Polite"
                                                    Click="ResumeLogFollowButton_Click" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <Grid x:Name="TasksView"
                          Margin="24"
                          MaxWidth="1120"
                          HorizontalAlignment="Stretch"
                          Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="任务"
                                       Style="{StaticResource WindowTitleTextStyle}" />

                            <Border x:Name="ProjectValidationBorder"
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    Padding="12,8"
                                    Background="{StaticResource Brush.Error.Surface}"
                                    BorderBrush="{StaticResource Brush.Error.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="ProjectValidationText"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.Error.Foreground}"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           AutomationProperties.Name="任务配置校验结果"
                                           AutomationProperties.LiveSetting="Polite" />
                            </Border>

                            <Border x:Name="ProjectEmptyStatePanel"
                                    Grid.Row="2"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource SettingsSectionPanelStyle}">
                                <StackPanel MaxWidth="460"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="ProjectEmptyStateTitleText"
                                               HorizontalAlignment="Center"
                                               Text="MaaNOP 项目无法加载"
                                               TextAlignment="Center"
                                               Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock x:Name="ProjectEmptyStateDetailText"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               Text="请使用完整的 MaaNOP 发布包，确保安装目录下直接包含 interface.json。"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Border>

                            <Grid x:Name="TaskWorkspacePanel"
                                  Grid.Row="2"
                                  Margin="0,16,0,0"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" MinWidth="200" MaxWidth="260" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SettingsSectionPanelStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="任务列表"
                                                   Style="{StaticResource SectionTitleTextStyle}" />
                                        <ListBox x:Name="TaskListBox"
                                                 Grid.Row="1"
                                                 Margin="0,12,0,0"
                                                 Style="{StaticResource TaskListBoxStyle}"
                                                 SelectionChanged="TaskListBox_SelectionChanged"
                                                 AutomationProperties.Name="任务列表"
                                                 AutomationProperties.HelpText="按项目声明顺序选择一个任务">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource SettingsSectionPanelStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="任务参数"
                                                       Style="{StaticResource SectionTitleTextStyle}" />
                                            <Border Grid.Row="1"
                                                    Height="1"
                                                    Margin="0,10,0,12"
                                                    Background="{StaticResource Brush.Border}"
                                                    SnapsToDevicePixels="True" />
                                            <ScrollViewer Grid.Row="2"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="OptionEditorPanel" Margin="0,0,4,0" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="TaskDescriptionPanel"
                                            Grid.Row="1"
                                            Margin="0,12,0,0"
                                            Style="{StaticResource SettingsSectionPanelStyle}"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="任务描述"
                                                       Style="{StaticResource SectionTitleTextStyle}" />
                                            <Border Height="1"
                                                    Margin="0,10,0,12"
                                                    Background="{StaticResource Brush.Border}"
                                                    SnapsToDevicePixels="True" />
                                            <TextBlock x:Name="TaskDescriptionText"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                    </Grid>

                    <ScrollViewer x:Name="SettingsView"
                                  Visibility="Collapsed"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="设置" Style="{StaticResource WindowTitleTextStyle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="配置游戏入口和应用行为；MaaNOP 项目随发布包固定在程序目录下。"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                                <TextBlock Text="游戏启动" Style="{StaticResource SectionTitleTextStyle}" />
                                <Label Margin="0,14,0,0"
                                       Content="游戏程序(_P)"
                                       Target="{Binding ElementName=GamePathTextBox}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GamePathTextBox"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                             AutomationProperties.HelpText="游戏 exe 路径"
                                             LostKeyboardFocus="PathsTextBox_LostKeyboardFocus" />
                                    <Button Grid.Column="2"
                                            Content="浏览…(_B)"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Click="BrowseGameButton_Click" />
                                </Grid>

                                <Label Margin="0,14,0,0"
                                       Content="启动参数(_A)"
                                       Target="{Binding ElementName=GameArgumentsTextBox}" />
                                <TextBox x:Name="GameArgumentsTextBox"
                                          Margin="0,6,0,0"
                                          ToolTip="传递给游戏启动程序的命令行参数"
                                          AutomationProperties.HelpText="火影忍者 Online 使用 -/appid:1103286479"
                                          LostKeyboardFocus="PathsTextBox_LostKeyboardFocus" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="火影忍者 Online 默认通过 QQMicroGameBox\Launch.exe 和 appid 参数启动。"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,24,0,24">
                                <Border Height="1"
                                        Margin="0,0,0,24"
                                        Background="{StaticResource Brush.Border}"
                                        SnapsToDevicePixels="True" />
                                <TextBlock Text="应用行为" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Margin="0,10,0,0"
                                           Text="关闭主窗口时会隐藏到系统托盘，任务与桌面分身继续运行。请使用托盘菜单中的“退出程序”完成清理。"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <Border Grid.Row="2"
                Padding="16,0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="GlobalReadyIndicator"
                             Width="6"
                             Height="6"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource Brush.Text.Muted}" />
                    <TextBlock x:Name="GlobalReadyText"
                               Text="整体：尚未就绪"
                               Style="{StaticResource MonospaceMetaTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="GlobalWorkerIndicator"
                             Width="6"
                             Height="6"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource Brush.Text.Muted}" />
                    <TextBlock x:Name="GlobalWorkerStatusText"
                               Text="Worker：尚未启动"
                               Style="{StaticResource MonospaceMetaTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="GlobalSessionIndicator"
                             Width="6"
                             Height="6"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource Brush.Text.Muted}" />
                    <TextBlock x:Name="GlobalSessionStatusText"
                               Text="Session：未运行"
                               Style="{StaticResource MonospaceMetaTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="GlobalIpcIndicator"
                             Width="6"
                             Height="6"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource Brush.Text.Muted}" />
                    <TextBlock x:Name="GlobalIpcStatusText"
                               Text="IPC：未连接"
                               Style="{StaticResource MonospaceMetaTextStyle}" />
                </StackPanel>

                <TextBlock x:Name="OperationStatusText"
                           Grid.Column="4"
                           Margin="24,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="就绪"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource SecondaryTextStyle}"
                           AutomationProperties.Name="操作状态"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="OperationProgressBar"
                             Grid.Column="5"
                             Width="120"
                             Height="4"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             IsTabStop="False"
                             AutomationProperties.Name="操作正在进行" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
