<Window x:Class="NarutoAutoGUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NarutoAutoGUI"
        Width="1040"
        Height="760"
        MinWidth="860"
        MinHeight="660"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="{StaticResource Thickness.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource StatusPanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource Brush.BrandAccent}"
                        CornerRadius="2" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="桌面分身" Style="{StaticResource WindowTitleTextStyle}" />
                    <TextBlock x:Name="SessionStatusText"
                               Text="正在检测桌面分身…"
                               Margin="0,4,0,0"
                               Style="{StaticResource StatusPrimaryTextStyle}"
                               AutomationProperties.Name="桌面分身状态"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="SessionDetailText"
                               Text="正在检查是否存在可恢复的桌面分身。"
                               Margin="0,4,0,0"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock x:Name="SessionIdText"
                               Text="Session —  ·  RDP —"
                               Margin="0,4,0,0"
                               Style="{StaticResource MonospaceMetaTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border x:Name="SessionStatusBadge" Style="{StaticResource StatusBadgeStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SessionStatusIndicator"
                                     Width="6"
                                     Height="6"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource Brush.Info.Foreground}" />
                            <TextBlock x:Name="SessionStatusBadgeText"
                                       Text="检测中"
                                       Foreground="{StaticResource Brush.Info.Foreground}"
                                       FontSize="{StaticResource FontSize.Label}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="1920 × 1080  ·  100%"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Right"
                               Style="{StaticResource MonospaceMetaTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Grid.Row="1" Header="桌面分身控制">
            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="CreateSessionButton"
                        Grid.Column="0"
                        Content="创建 / 恢复(_C)"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CreateSessionButton_Click"
                        AutomationProperties.HelpText="创建新的桌面分身，或恢复已有桌面分身的连接" />
                <Button x:Name="ShowSessionButton"
                        Grid.Column="2"
                        Content="显示子桌面(_S)"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="ShowSessionButton_Click"
                        AutomationProperties.HelpText="显示已连接但当前隐藏的子桌面" />
                <Button x:Name="HideSessionButton"
                        Grid.Column="4"
                        Content="隐藏子桌面(_H)"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="HideSessionButton_Click"
                        AutomationProperties.HelpText="隐藏子桌面窗口，同时保持连接和其中的程序运行" />
                <Button x:Name="TerminateSessionButton"
                        Grid.Column="6"
                        Content="结束桌面分身(_E)"
                        Style="{StaticResource DestructiveButtonStyle}"
                        Click="TerminateSessionButton_Click"
                        AutomationProperties.HelpText="注销桌面分身并结束其中运行的程序" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="程序启动">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                       Grid.Column="0"
                       Content="游戏程序(_P)"
                       Target="{Binding ElementName=GamePathTextBox}" />
                <TextBox x:Name="GamePathTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         AutomationProperties.HelpText="游戏 exe 路径"
                         LostKeyboardFocus="PathsTextBox_LostKeyboardFocus" />
                <Button Grid.Row="0"
                        Grid.Column="3"
                        Content="浏览…(_B)"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="BrowseGameButton_Click" />
                <Button x:Name="LaunchGameButton"
                        Grid.Row="0"
                        Grid.Column="5"
                        Content="启动游戏(_G)"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="LaunchGameButton_Click" />

                <Label Grid.Row="2"
                       Grid.Column="0"
                       Content="启动参数(_A)"
                       Target="{Binding ElementName=GameArgumentsTextBox}" />
                <TextBox x:Name="GameArgumentsTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="5"
                         ToolTip="传递给游戏启动程序的命令行参数"
                         AutomationProperties.HelpText="火影忍者 Online 使用 -/appid:1103286479"
                         LostKeyboardFocus="PathsTextBox_LostKeyboardFocus" />

                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Grid.ColumnSpan="5"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="火影忍者 Online 默认通过 QQMicroGameBox\Launch.exe 和 appid 参数启动；工作目录自动使用 exe 所在目录。" />

                <Label Grid.Row="6"
                       Grid.Column="0"
                       Content="MaaNOP(_M)"
                       Target="{Binding ElementName=MaaNopPathTextBox}" />
                <TextBox x:Name="MaaNopPathTextBox"
                         Grid.Row="6"
                         Grid.Column="1"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         AutomationProperties.HelpText="MaaNOP exe 路径"
                         LostKeyboardFocus="PathsTextBox_LostKeyboardFocus" />
                <Button Grid.Row="6"
                        Grid.Column="3"
                        Content="浏览…(_R)"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="BrowseMaaNopButton_Click" />
                <Button x:Name="LaunchMaaNopButton"
                        Grid.Row="6"
                        Grid.Column="5"
                        Content="启动 MaaNOP(_N)"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="LaunchMaaNopButton_Click" />

                <Grid Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LaunchAllButton"
                            Grid.Column="0"
                            Content="一键启动挂机环境(_O)"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="LaunchAllButton_Click" />
                    <TextBlock Grid.Column="2"
                               Text="恢复/创建 → 显示 → 游戏 → MaaNOP → 保持显示"
                               VerticalAlignment="Center"
                               Style="{StaticResource SecondaryTextStyle}" />
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="运行日志（INFO+）">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="LogListBox"
                         Grid.Row="0"
                         ItemsSource="{Binding LogLines}"
                         Style="{StaticResource LogListBoxStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="运行日志"
                         AutomationProperties.HelpText="显示最近一千条 INFO 及以上级别日志">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="22"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="0,0,0,1"
                                    Padding="4,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SeverityMarker"
                                            Grid.Column="0"
                                            Background="{StaticResource Brush.Transparent}"
                                            CornerRadius="1" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               FontFamily="{StaticResource FontFamily.Monospace}"
                                               FontSize="{StaticResource FontSize.Meta}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="LogLevelText"
                                               Grid.Column="3"
                                               Text="{Binding DisplayLevel}"
                                               Foreground="{StaticResource Brush.Primary}"
                                               FontFamily="{StaticResource FontFamily.Monospace}"
                                               FontSize="{StaticResource FontSize.Meta}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Message}"
                                               Foreground="{StaticResource Brush.Text.Body}"
                                               FontFamily="{StaticResource FontFamily.Monospace}"
                                               FontSize="{StaticResource FontSize.Meta}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding DisplayLevel}" Value="WARN">
                                    <Setter TargetName="SeverityMarker" Property="Background" Value="{StaticResource Brush.Warning}" />
                                    <Setter TargetName="LogLevelText" Property="Foreground" Value="{StaticResource Brush.Warning.Foreground}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DisplayLevel}" Value="ERROR">
                                    <Setter TargetName="SeverityMarker" Property="Background" Value="{StaticResource Brush.Error}" />
                                    <Setter TargetName="LogLevelText" Property="Foreground" Value="{StaticResource Brush.Error.Foreground}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DisplayLevel}" Value="CRITICAL">
                                    <Setter TargetName="SeverityMarker" Property="Background" Value="{StaticResource Brush.Error}" />
                                    <Setter TargetName="LogLevelText" Property="Foreground" Value="{StaticResource Brush.Error.Foreground}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="0"
                           Text="暂无运行日志"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SecondaryTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=LogListBox}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button x:Name="ResumeLogFollowButton"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Content="有新日志，继续跟随(_F)"
                        Style="{StaticResource NewLogsButtonStyle}"
                        Margin="0,8,0,0"
                        Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Polite"
                        Click="ResumeLogFollowButton_Click" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="OperationStatusText"
                           Text="就绪"
                           VerticalAlignment="Center"
                           Style="{StaticResource SecondaryTextStyle}"
                           AutomationProperties.Name="操作状态"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="OperationProgressBar"
                             Width="120"
                             Height="4"
                             Margin="12,0,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             IsTabStop="False"
                             AutomationProperties.Name="操作正在进行" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="打开日志目录(_L)"
                    Style="{StaticResource SubtleButtonStyle}"
                    Click="OpenLogsButton_Click" />
            <TextBlock Grid.Column="3"
                       Text="关闭主窗口将隐藏到托盘"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}" />
        </Grid>
    </Grid>
</Window>
