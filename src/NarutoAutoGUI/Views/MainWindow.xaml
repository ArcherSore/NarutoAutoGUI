<ui:FluentWindow x:Class="NarutoAutoGUI.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:NarutoAutoGUI.Views"
                 xmlns:models="clr-namespace:NarutoAutoGUI.Models"
                 Title="NarutoAutoGUI"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1180"
                 Height="760"
                 MinWidth="920"
                 MinHeight="640"
                 Background="{StaticResource Brush.Canvas}"
                 Foreground="{StaticResource Brush.Text.Body}"
                 FontFamily="{StaticResource FontFamily.Ui}"
                 FontSize="{StaticResource FontSize.Body}"
                 ExtendsContentIntoTitleBar="True"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <views:ScrollEdgeVisibilityConverter x:Key="Scroll.EdgeVisibility" />
        <Style x:Key="Rail.Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=views:RailItem}}" />
            <Setter Property="FontWeight"
                    Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=views:RailItem}}" />
        </Style>
        <Style x:Key="Rail.Item" TargetType="views:RailItem">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="views:RailItem">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Indicator" Width="3" Height="20" Margin="-5,0,0,0" CornerRadius="1.5"
                                    HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{StaticResource Brush.Primary}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Rail.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsActive" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Rail.Active}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Configuration tabs are segments on one tinted bar. The scroll bar stays hidden; edge fades show where
             more tabs are clipped, and the add button sits outside the scroller. -->
        <Color x:Key="Configuration.BarColor">#E9EDF3</Color>
        <Color x:Key="Configuration.BarColor.Clear">#00E9EDF3</Color>
        <LinearGradientBrush x:Key="Configuration.FadeLeft" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="{StaticResource Configuration.BarColor}" />
            <GradientStop Offset="1" Color="{StaticResource Configuration.BarColor.Clear}" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Configuration.FadeRight" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="{StaticResource Configuration.BarColor.Clear}" />
            <GradientStop Offset="1" Color="{StaticResource Configuration.BarColor}" />
        </LinearGradientBrush>
        <ControlTemplate x:Key="Configuration.Scroll" TargetType="ScrollViewer">
            <Grid>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" />
                <Border x:Name="LeftFade" Width="28" HorizontalAlignment="Left" IsHitTestVisible="False"
                        Background="{StaticResource Configuration.FadeLeft}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource Scroll.EdgeVisibility}" ConverterParameter="Left">
                            <Binding Path="HorizontalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ScrollableWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
                <Border x:Name="RightFade" Width="28" HorizontalAlignment="Right" IsHitTestVisible="False"
                        Background="{StaticResource Configuration.FadeRight}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource Scroll.EdgeVisibility}" ConverterParameter="Right">
                            <Binding Path="HorizontalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ScrollableWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
            </Grid>
        </ControlTemplate>
        <Style x:Key="Configuration.Bar" TargetType="Border">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource Configuration.BarColor}" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Configuration.Tab" TargetType="TabItem">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MaxWidth" Value="200" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Segment" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" Margin="11,0,4,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#8CFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Segment" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270"
                                                          Opacity="0.14" Color="#182230" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush"
                                        Value="{StaticResource Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Configuration.Add" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Configuration.Delete" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TabItem}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                    <Setter Property="Background" Value="{StaticResource Brush.Error.Surface}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Background" Value="{StaticResource Brush.Error.Surface}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <views:LatestActivityConverter x:Key="Activity.IsLatest" />
        <Style x:Key="Activity.ClearButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Disabled}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="True" />
                        <Condition Property="IsPressed" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brush.Border.Subtle}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#A6B6CD" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <LinearGradientBrush x:Key="Scroll.FadeTop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="{StaticResource Color.Neutral.50}" />
            <GradientStop Offset="1" Color="{StaticResource Color.Neutral.50.Clear}" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Scroll.FadeBottom" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="{StaticResource Color.Neutral.50.Clear}" />
            <GradientStop Offset="1" Color="{StaticResource Color.Neutral.50}" />
        </LinearGradientBrush>
        <!-- Canvas scroll areas: overlay thin scrollbar in the right gutter, edges fade while more content exists. -->
        <ControlTemplate x:Key="Scroll.Faded" TargetType="ScrollViewer">
            <Grid>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        CanContentScroll="{TemplateBinding CanContentScroll}" />
                <Border x:Name="TopFade" Height="{StaticResource Height.ScrollFade}" VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Background="{StaticResource Scroll.FadeTop}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource Scroll.EdgeVisibility}" ConverterParameter="Top">
                            <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
                <Border x:Name="BottomFade" Height="{StaticResource Height.ScrollFade}" VerticalAlignment="Bottom"
                        IsHitTestVisible="False"
                        Background="{StaticResource Scroll.FadeBottom}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource Scroll.EdgeVisibility}" ConverterParameter="Bottom">
                            <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
                <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Minimum="0"
                           Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{Binding VerticalOffset, Mode=OneWay,
                               RelativeSource={RelativeSource TemplatedParent}}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
        </ControlTemplate>
        <SolidColorBrush x:Key="Preview.Border" Color="#DCE6F5" />
        <Style x:Key="Preview.IconFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Preview.IconButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Preview.IconFocus}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Disabled}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Border}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Runtime sidebar resize handle: invisible at rest. Hover, drag and keyboard focus show a round handle
             centred on the console's left border; MainWindow places it and picks the state. -->
        <ControlTemplate x:Key="Console.ResizeHandle" TargetType="GridSplitter">
            <ControlTemplate.Resources>
                <QuarticEase x:Key="Handle.Pop" EasingMode="EaseOut" />
                <QuadraticEase x:Key="Handle.Out" EasingMode="EaseOut" />
                <QuadraticEase x:Key="Handle.In" EasingMode="EaseIn" />
            </ControlTemplate.Resources>
            <Grid Background="{TemplateBinding Background}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="HandleStates">
                        <VisualStateGroup.Transitions>
                            <!-- A 60 ms intent delay so sweeping across the gap never flashes, then a short pop. -->
                            <VisualTransition From="Hidden" To="Hover">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Handle" Storyboard.TargetProperty="Opacity"
                                                     To="1" BeginTime="0:0:0.06" Duration="0:0:0.14"
                                                     EasingFunction="{StaticResource Handle.Pop}" />
                                    <DoubleAnimation Storyboard.TargetName="HandleScale"
                                                     Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.06"
                                                     Duration="0:0:0.18" EasingFunction="{StaticResource Handle.Pop}" />
                                    <DoubleAnimation Storyboard.TargetName="HandleScale"
                                                     Storyboard.TargetProperty="ScaleY" To="1" BeginTime="0:0:0.06"
                                                     Duration="0:0:0.18" EasingFunction="{StaticResource Handle.Pop}" />
                                    <DoubleAnimation Storyboard.TargetName="Tether" Storyboard.TargetProperty="Opacity"
                                                     To="1" BeginTime="0:0:0.06" Duration="0:0:0.14"
                                                     EasingFunction="{StaticResource Handle.Out}" />
                                    <DoubleAnimation Storyboard.TargetName="TetherScale"
                                                     Storyboard.TargetProperty="ScaleY" To="0.75" BeginTime="0:0:0.06"
                                                     Duration="0:0:0.18" EasingFunction="{StaticResource Handle.Pop}" />
                                    <BooleanAnimationUsingKeyFrames Storyboard.TargetName="Handle"
                                                                    Storyboard.TargetProperty="IsHitTestVisible">
                                        <DiscreteBooleanKeyFrame KeyTime="0" Value="True" />
                                    </BooleanAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualTransition>
                            <VisualTransition From="Hidden" To="Keyboard">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Handle" Storyboard.TargetProperty="Opacity"
                                                     To="1" BeginTime="0:0:0.06" Duration="0:0:0.14"
                                                     EasingFunction="{StaticResource Handle.Pop}" />
                                    <DoubleAnimation Storyboard.TargetName="HandleScale"
                                                     Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.06"
                                                     Duration="0:0:0.18" EasingFunction="{StaticResource Handle.Pop}" />
                                    <DoubleAnimation Storyboard.TargetName="HandleScale"
                                                     Storyboard.TargetProperty="ScaleY" To="1" BeginTime="0:0:0.06"
                                                     Duration="0:0:0.18" EasingFunction="{StaticResource Handle.Pop}" />
                                    <DoubleAnimation Storyboard.TargetName="Tether" Storyboard.TargetProperty="Opacity"
                                                     To="1" BeginTime="0:0:0.06" Duration="0:0:0.14"
                                                     EasingFunction="{StaticResource Handle.Out}" />
                                    <DoubleAnimation Storyboard.TargetName="TetherScale"
                                                     Storyboard.TargetProperty="ScaleY" To="0.75" BeginTime="0:0:0.06"
                                                     Duration="0:0:0.18" EasingFunction="{StaticResource Handle.Pop}" />
                                    <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                     Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    <DoubleAnimation Storyboard.TargetName="DiscShadow"
                                                     Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                </Storyboard>
                            </VisualTransition>
                        </VisualStateGroup.Transitions>
                        <!-- Fades out in 90 ms and keeps its last position. -->
                        <VisualState x:Name="Hidden">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Handle" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.09"
                                                 EasingFunction="{StaticResource Handle.In}" />
                                <DoubleAnimation Storyboard.TargetName="HandleScale" Storyboard.TargetProperty="ScaleX"
                                                 To="0.7" Duration="0:0:0.09"
                                                 EasingFunction="{StaticResource Handle.In}" />
                                <DoubleAnimation Storyboard.TargetName="HandleScale" Storyboard.TargetProperty="ScaleY"
                                                 To="0.7" Duration="0:0:0.09"
                                                 EasingFunction="{StaticResource Handle.In}" />
                                <DoubleAnimation Storyboard.TargetName="Tether" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.09"
                                                 EasingFunction="{StaticResource Handle.In}" />
                                <DoubleAnimation Storyboard.TargetName="TetherScale" Storyboard.TargetProperty="ScaleY"
                                                 To="0.6" Duration="0:0:0.09"
                                                 EasingFunction="{StaticResource Handle.In}" />
                                <ColorAnimation Storyboard.TargetName="DiscFill" Storyboard.TargetProperty="Color"
                                                To="{StaticResource Color.Neutral.0}" Duration="0:0:0.12" />
                                <ColorAnimation Storyboard.TargetName="DiscStroke" Storyboard.TargetProperty="Color"
                                                To="{StaticResource Color.Indigo.200}" Duration="0:0:0.12" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Hover">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Handle" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.14"
                                                 EasingFunction="{StaticResource Handle.Pop}" />
                                <DoubleAnimation Storyboard.TargetName="HandleScale" Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.18"
                                                 EasingFunction="{StaticResource Handle.Pop}" />
                                <DoubleAnimation Storyboard.TargetName="HandleScale" Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.18"
                                                 EasingFunction="{StaticResource Handle.Pop}" />
                                <DoubleAnimation Storyboard.TargetName="Tether" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.14"
                                                 EasingFunction="{StaticResource Handle.Out}" />
                                <DoubleAnimation Storyboard.TargetName="TetherScale" Storyboard.TargetProperty="ScaleY"
                                                 To="0.75" Duration="0:0:0.18"
                                                 EasingFunction="{StaticResource Handle.Pop}" />
                                <BooleanAnimationUsingKeyFrames Storyboard.TargetName="Handle"
                                                                Storyboard.TargetProperty="IsHitTestVisible">
                                    <DiscreteBooleanKeyFrame KeyTime="0" Value="True" />
                                </BooleanAnimationUsingKeyFrames>
                                <ColorAnimation Storyboard.TargetName="DiscFill" Storyboard.TargetProperty="Color"
                                                To="{StaticResource Color.Neutral.0}" Duration="0:0:0.12" />
                                <ColorAnimation Storyboard.TargetName="DiscStroke" Storyboard.TargetProperty="Color"
                                                To="{StaticResource Color.Indigo.200}" Duration="0:0:0.12" />
                            </Storyboard>
                        </VisualState>
                        <!-- Pressed tint, primary ring and a longer primary edge segment; no fill, no motion. -->
                        <VisualState x:Name="Dragging">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Handle" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetName="HandleScale" Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetName="HandleScale" Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetName="Tether" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetName="TetherScale" Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.14"
                                                 EasingFunction="{StaticResource Handle.Out}" />
                                <DoubleAnimation Storyboard.TargetName="TetherStrong"
                                                 Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                <BooleanAnimationUsingKeyFrames Storyboard.TargetName="Handle"
                                                                Storyboard.TargetProperty="IsHitTestVisible">
                                    <DiscreteBooleanKeyFrame KeyTime="0" Value="True" />
                                </BooleanAnimationUsingKeyFrames>
                                <ColorAnimation Storyboard.TargetName="DiscFill" Storyboard.TargetProperty="Color"
                                                To="{StaticResource Color.Indigo.100}" Duration="0:0:0.1" />
                                <ColorAnimation Storyboard.TargetName="DiscStroke" Storyboard.TargetProperty="Color"
                                                To="{StaticResource Color.Indigo.600}" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetName="DiscShadow" Storyboard.TargetProperty="Opacity"
                                                 To="0.1" Duration="0:0:0.1" />
                            </Storyboard>
                        </VisualState>
                        <!-- The hover look at mid-height, with a focus ring in place of the shadow. -->
                        <VisualState x:Name="Keyboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Handle" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.14"
                                                 EasingFunction="{StaticResource Handle.Pop}" />
                                <DoubleAnimation Storyboard.TargetName="HandleScale" Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.18"
                                                 EasingFunction="{StaticResource Handle.Pop}" />
                                <DoubleAnimation Storyboard.TargetName="HandleScale" Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.18"
                                                 EasingFunction="{StaticResource Handle.Pop}" />
                                <DoubleAnimation Storyboard.TargetName="Tether" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.14"
                                                 EasingFunction="{StaticResource Handle.Out}" />
                                <DoubleAnimation Storyboard.TargetName="TetherScale" Storyboard.TargetProperty="ScaleY"
                                                 To="0.75" Duration="0:0:0.18"
                                                 EasingFunction="{StaticResource Handle.Pop}" />
                                <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="DiscShadow" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.12" />
                                <ColorAnimation Storyboard.TargetName="DiscFill" Storyboard.TargetProperty="Color"
                                                To="{StaticResource Color.Neutral.0}" Duration="0:0:0.12" />
                                <ColorAnimation Storyboard.TargetName="DiscStroke" Storyboard.TargetProperty="Color"
                                                To="{StaticResource Color.Indigo.200}" Duration="0:0:0.12" />
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <!-- Reaches 10 DIP over the console so the handle can straddle its border. -->
                <Grid Margin="0,0,-10,0">
                    <!-- Edge segment: lights the console's own border around the handle, clipped clear of the
                         10 DIP rounded corners. -->
                    <Grid Width="1" Margin="0,10,9,10" HorizontalAlignment="Right" ClipToBounds="True"
                          IsHitTestVisible="False">
                        <Grid x:Name="Tether" Height="96" VerticalAlignment="Top" Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="TetherScale" ScaleY="0.6" />
                            </Grid.RenderTransform>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#008FA8DA" Offset="0" />
                                        <GradientStop Color="#8FA8DA" Offset="0.5" />
                                        <GradientStop Color="#008FA8DA" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="TetherStrong" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#003156A3" Offset="0" />
                                        <GradientStop Color="{StaticResource Color.Indigo.600}" Offset="0.5" />
                                        <GradientStop Color="#003156A3" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>
                    <!-- Hit-testable only while shown, so at rest it never covers the console's controls. -->
                    <Grid x:Name="Handle" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="HandleScale" ScaleX="0.7" ScaleY="0.7" />
                        </Grid.RenderTransform>
                        <Grid x:Name="FocusRing" Margin="-4" Opacity="0">
                            <Ellipse Stroke="#993156A3" StrokeThickness="2" />
                            <Ellipse Margin="2" Stroke="{StaticResource Brush.Surface}" StrokeThickness="2" />
                        </Grid>
                        <Ellipse StrokeThickness="1">
                            <Ellipse.Fill>
                                <SolidColorBrush x:Name="DiscFill" Color="{StaticResource Color.Neutral.0}" />
                            </Ellipse.Fill>
                            <Ellipse.Stroke>
                                <SolidColorBrush x:Name="DiscStroke" Color="{StaticResource Color.Indigo.200}" />
                            </Ellipse.Stroke>
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="DiscShadow" BlurRadius="7" ShadowDepth="1" Direction="270"
                                                  Opacity="0.16" Color="{StaticResource Color.Neutral.900}" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Viewbox Width="12" Height="12">
                            <Path Width="16" Height="16" Stroke="{StaticResource Brush.Primary}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                                                        StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M2.5,8 H13.5 M5,5.5 L2.5,8 L5,10.5 M11,5.5 L13.5,8 L11,10.5" />
                        </Viewbox>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
        <!-- Runtime console: one card whose sections are divided by hairlines. -->
        <Style x:Key="Console.Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.06"
                                      Color="#182230" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Console.Section" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style x:Key="Console.SectionHeader" TargetType="Grid">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="16,0,8,0" />
        </Style>
        <Style x:Key="Console.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        </Style>
        <Style x:Key="Console.Pill" TargetType="Border">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8,0,9,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Console.ButtonText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="Console.PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="Console.NeutralButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Subdued}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Console.DangerButton" TargetType="Button" BasedOn="{StaticResource Console.NeutralButton}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Error.Foreground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Error.Border}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Error.Surface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Error}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Header desktop toggle: glyph, status dot and the word 分身. Only an open viewer fills it: Tag="On" while
             watching, Tag="Warn" while input reaches the Child Session. Disabled mutes only an unfilled toggle: a
             viewer opened during preparation stays visibly open while the toggle waits. -->
        <Style x:Key="Console.SessionToggle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="8,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Body}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Preview.IconFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Subdued}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                </Trigger>
                <Trigger Property="Tag" Value="On">
                    <Setter Property="Background" Value="{StaticResource Brush.Primary.Surface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary.Border}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Tag" Value="On" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brush.Primary.SurfaceHover}" />
                </MultiTrigger>
                <Trigger Property="Tag" Value="Warn">
                    <Setter Property="Background" Value="{StaticResource Brush.Warning.Surface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning.SurfaceHover}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning.Foreground}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Tag" Value="Warn" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brush.Warning.SurfaceHover}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="False" />
                        <Condition Property="Tag" Value="{x:Null}" />
                    </MultiTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Update.ButtonLabel">
            <TextBlock Text="{Binding}" FontWeight="SemiBold"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </DataTemplate>
        <Style x:Key="Update.PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource Update.ButtonLabel}" />
        </Style>
        <Style x:Key="Update.SecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource Update.ButtonLabel}" />
            <Setter Property="Background" Value="{StaticResource Brush.Primary.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Preview.Border}" />
        </Style>
        <!-- Parameter editors share one height. The implicit TextBlock style keeps disabled caption text dark,
             so a locked dropdown or switch fades as a whole; the text box has its own disabled colours. -->
        <Style x:Key="Option.TextBox" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,5,10,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClearButtonEnabled" Value="False" />
        </Style>
        <Style x:Key="Option.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,5,10,5" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Option.ToggleSwitch" TargetType="ui:ToggleSwitch"
               BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid x:Name="WindowOverlayRoot">
    <Grid x:Name="MainWindowContent">
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=UpdateOverlay}" Value="Visible">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Performance" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
                     Grid.Row="0"
                     Title="NarutoAutoGUI"
                     Background="{StaticResource Brush.Canvas}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
