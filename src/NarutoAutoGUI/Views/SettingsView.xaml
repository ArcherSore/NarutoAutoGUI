<UserControl x:Class="NarutoAutoGUI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:settings="clr-namespace:NarutoAutoGUI.Settings">
    <UserControl.Resources>
        <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ItemHeading" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <DataTemplate x:Key="ToggleRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Definition.Title}" Style="{StaticResource ItemHeading}" />
                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource OptionalText}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center"
                                 OnContent="{x:Null}" OffContent="{x:Null}"
                                 IsChecked="{Binding Toggle.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="{Binding Definition.Id}"
                                 AutomationProperties.Name="{Binding Definition.Title}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ActionRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Definition.Title}" Style="{StaticResource ItemHeading}" />
                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource OptionalText}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Action.Status}" Margin="0,4,0,0"
                               AutomationProperties.LiveSetting="Polite" Style="{StaticResource OptionalText}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding Definition.ButtonText}" Command="{Binding Action}"
                        ToolTip="{Binding Action.ToolTip}" Margin="24,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="{Binding Definition.Id}"
                        AutomationProperties.Name="{Binding Definition.ButtonText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="InfoRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Definition.Title}" Style="{StaticResource ItemHeading}" />
                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource OptionalText}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Value.Text}" Margin="24,0,0,0"
                           VerticalAlignment="Center" Style="{StaticResource OptionalText}" />
            </Grid>
        </DataTemplate>
        <Style x:Key="SettingRow" TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.Toggle}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ToggleRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.Action}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ActionRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.Info}">
                    <Setter Property="ContentTemplate" Value="{StaticResource InfoRow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Style.Triggers>
                <DataTrigger Value="0" Binding="{Binding (ItemsControl.AlternationIndex),
                    RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="820" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Definition.Title}" Style="{StaticResource WindowTitleTextStyle}" />
                <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource OptionalText}"
                           Margin="0,4,0,0" />
                <ItemsControl ItemsSource="{Binding Sections}" Margin="0,20,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="{Binding Definition.Title}"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="{Binding Definition.Description}" Margin="0,4,0,0"
                                           Style="{StaticResource OptionalText}" />
                                <Border Margin="0,8,0,0" Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Section}">
                                    <ItemsControl ItemsSource="{Binding Items}" AlternationCount="2147483647">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowBorder}">
                                                    <ContentControl Content="{Binding}"
                                                                    Style="{StaticResource SettingRow}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
