<UserControl x:Class="NarutoAutoGUI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:NarutoAutoGUI.Views"
             xmlns:settings="clr-namespace:NarutoAutoGUI.Settings">
    <UserControl.Resources>
        <CornerRadius x:Key="Radius.Settings">8</CornerRadius>
        <!-- WPF-UI's default blue would sit next to the indigo list highlight. -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource Color.Indigo.600}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource Color.Indigo.700}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource Color.Indigo.800}" />
        <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ItemHeading" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="ItemDescription" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
        </Style>
        <Style x:Key="ItemIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
        </Style>
        <!-- The quiet filled button that keeps rows calm; the outlined default would compete with the text. -->
        <Style x:Key="ItemButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Margin" Value="24,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Disabled}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Body}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True"
                                CornerRadius="{StaticResource Radius.Settings}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Border}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Border.Strong}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Definition.Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="12,8"
                                CornerRadius="{StaticResource Radius.Settings}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Disabled}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Inverse}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ToggleRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="{Binding Definition.Icon}" Style="{StaticResource ItemIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Definition.Title}" Style="{StaticResource ItemHeading}" />
                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource ItemDescription}" />
                    <TextBlock Text="{Binding Toggle.Status}" Style="{StaticResource OptionalText}"
                               Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center"
                                 OnContent="{x:Null}" OffContent="{x:Null}"
                                 IsChecked="{Binding Toggle.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Toggle.IsEnabled}"
                                 AutomationProperties.AutomationId="{Binding Definition.Id}"
                                 AutomationProperties.Name="{Binding Definition.Title}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ChoiceRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="{Binding Definition.Icon}" Style="{StaticResource ItemIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Definition.Title}" Style="{StaticResource ItemHeading}" />
                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource ItemDescription}" />
                    <TextBlock Text="{Binding Choice.Status}" Style="{StaticResource OptionalText}"
                               Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <ComboBox Grid.Column="2" Margin="24,0,0,0" MinWidth="200" VerticalAlignment="Center"
                          ItemsSource="{Binding Choice.Options}" DisplayMemberPath="Name"
                          SelectedItem="{Binding Choice.Selected, Mode=TwoWay}"
                          AutomationProperties.AutomationId="{Binding Definition.Id}"
                          AutomationProperties.Name="{Binding Definition.Title}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ActionRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="{Binding Definition.Icon}" Style="{StaticResource ItemIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Definition.Title}" Style="{StaticResource ItemHeading}" />
                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource ItemDescription}" />
                    <TextBlock Text="{Binding Action.Status}" Margin="0,4,0,0"
                               AutomationProperties.LiveSetting="Polite" Style="{StaticResource OptionalText}" />
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding Definition.ButtonText}" Command="{Binding Action}"
                        ToolTip="{Binding Action.ToolTip}" Style="{StaticResource ItemButton}"
                        AutomationProperties.AutomationId="{Binding Definition.Id}"
                        AutomationProperties.Name="{Binding Definition.ButtonText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="InfoRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="{Binding Definition.Icon}" Style="{StaticResource ItemIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Definition.Title}" Style="{StaticResource ItemHeading}" />
                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource ItemDescription}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Value.Text}" Margin="24,0,0,0"
                           VerticalAlignment="Center" Style="{StaticResource OptionalText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AboutRow">
            <StackPanel>
                <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                    <Image x:Name="ProjectAboutIcon" Width="72" Height="72"
                           Source="{Binding About.Icon, TargetNullValue='pack://application:,,,/Assets/app.png'}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="ProjectAboutName"
                               Text="{Binding About.Content.Name, FallbackValue=NarutoAutoGUI}" Margin="0,12,0,0"
                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"
                               TextAlignment="Center" />
                </StackPanel>
                <views:ProjectAboutView Project="{Binding About.Content}" OpenLink="{Binding About.OpenLink}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SettingRow" TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.Toggle}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ToggleRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.Choice}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ChoiceRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.Action}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ActionRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.Info}">
                    <Setter Property="ContentTemplate" Value="{StaticResource InfoRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.About}">
                    <Setter Property="ContentTemplate" Value="{StaticResource AboutRow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Style.Triggers>
                <DataTrigger Value="0" Binding="{Binding (ItemsControl.AlternationIndex),
                    RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action.IsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Padding="12,16" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
            <!-- No scroll host: the list is short, and the content column owns scrolling. -->
            <ListBox x:Name="SectionNavigation" ItemsSource="{Binding Sections}" SelectedIndex="0"
                     ItemContainerStyle="{StaticResource NavigationItem}"
                     AutomationProperties.Name="设置分类"
                     SelectionChanged="SectionNavigation_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding Definition.Icon}" FontSize="16" Margin="0,0,8,0"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="{Binding Definition.Title}" FontWeight="Medium"
                                       Foreground="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <ScrollViewer x:Name="SectionScroller" Grid.Column="1" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" ScrollChanged="SectionScroller_ScrollChanged">
            <Grid Margin="24" MaxWidth="624">
                <ItemsControl x:Name="SectionList" ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding Definition.Icon}" FontSize="16" Margin="0,0,8,0"
                                                   Foreground="{StaticResource Brush.Text.Primary}" />
                                    <TextBlock Text="{Binding Definition.Title}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Primary}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Definition.Description}" Margin="0,4,0,0"
                                           Style="{StaticResource OptionalText}" />
                                <ItemsControl ItemsSource="{Binding Cards}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12" Background="{StaticResource Brush.Surface}"
                                                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                                    CornerRadius="10">
                                                <ItemsControl ItemsSource="{Binding}"
                                                              AlternationCount="2147483647">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource RowBorder}">
                                                                <ContentControl Content="{Binding}"
                                                                    Style="{StaticResource SettingRow}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
