<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>../NarutoAutoGUI/Assets/app.ico</ApplicationIcon>
    <BeautyLibsDir>libs</BeautyLibsDir>
    <BeautyOnPublishOnly>True</BeautyOnPublishOnly>
    <!-- Keep the loader-based layout so publishing does not require a versioned HostFXR patch. -->
    <BeautyUsePatch>False</BeautyUsePatch>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="SubdirectoriesToProbe" Value="libs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="nulastudio.NetBeauty" Version="2.1.5" />
    <ProjectReference Include="../NarutoAutoGUI.Updates/NarutoAutoGUI.Updates.csproj" />
  </ItemGroup>
</Project>
