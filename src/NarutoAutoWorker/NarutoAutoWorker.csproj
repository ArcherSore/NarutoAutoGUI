<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>NarutoAutoWorker</AssemblyName>
    <RootNamespace>NarutoAutoWorker</RootNamespace>
    <Version>0.1.0</Version>
    <Company>NarutoAutoGUI</Company>
    <Product>NarutoAutoWorker</Product>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NarutoAutoGUI.Protocol\NarutoAutoGUI.Protocol.csproj" />
    <PackageReference Include="Maa.Framework" Version="5.10.0" />
    <PackageReference Include="Maa.Framework.Runtimes" Version="5.12.3" />
  </ItemGroup>

</Project>
