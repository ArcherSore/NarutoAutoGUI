<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>Bunshin.Worker</AssemblyName>
    <RootNamespace>Worker</RootNamespace>
    <Version>0.1.0</Version>
    <Company>Bunshin</Company>
    <Product>Bunshin.Worker</Product>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Protocol\Protocol.csproj" />
    <PackageReference Include="Maa.Framework" Version="5.10.0" />
    <PackageReference Include="Maa.Framework.Runtimes" Version="5.12.3" />
    <PackageReference Include="Sentry" Version="6.12.1" />
    <Compile Include="..\Gui\Infrastructure\SelfTestSuite.cs" Link="SelfTestSuite.cs" />
  </ItemGroup>

  <!-- Maa.AgentBinary only holds Android agents; the Worker controls Win32 windows. -->
  <Target Name="ExcludeMaaAgentBinary" AfterTargets="CopyMaaAgentBinaryFilesToOutput">
    <ItemGroup>
      <Content Remove="@(_MaaAgentBinaryItems)" />
    </ItemGroup>
  </Target>

</Project>
